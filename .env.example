# Copy to .env.local for local dev (docker-compose defaults below match docker-compose.yml).
# Never commit a real .env file — secretlint + .gitignore both guard against this, but the rule
# is "never", not "the tools will catch it."

NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://schoolos:schoolos@localhost:5432/schoolos?schema=public
REDIS_URL=redis://localhost:6379

# openssl rand -base64 48 (or equivalent) — real, distinct secrets in every non-local environment,
# stored in a secret manager, never in this file for real.
JWT_ACCESS_SECRET=dev-only-change-me-access
JWT_REFRESH_SECRET=dev-only-change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Comma-separated — must match the frontend's real origin(s), never "*" once cookies are in play
# (security-standards: "CORS: explicit origin allowlist, not *, especially once cookies are in
# play").
CORS_ORIGINS=http://localhost:5173

S3_ENDPOINT=http://localhost:19000
S3_BUCKET=schoolos-documents
S3_ACCESS_KEY_ID=schoolos
S3_SECRET_ACCESS_KEY=schoolos123

# Phase 7.1 — the origin baked into a generated certificate's QR code (its own downstream page
# lives on the frontend, not this API). Matches CORS_ORIGINS above in local dev.
FRONTEND_BASE_URL=http://localhost:5173

# Phase 7.9 — Platform Console billing (PRD §53). Optional: leave unset for local dev/CI and
# `platform/billing-provider.ts` falls back to `LocalBillingProvider`, a real (not fake) dev
# stand-in, same "log it, don't fail the request" discipline as the auth module's forgot-password
# email placeholder. Set both to real Stripe test-mode values to exercise StripeBillingProvider.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Phase 7.9 — `prisma/seed.ts` reads these (not AppConfigService — a seed script, not part of the
# Nest app). Optional: dev-only defaults (`super-admin@schoolos.dev` / `dev-only-change-me-super-
# admin`) apply if unset, same "safe default, real value everywhere but local dev" posture as
# JWT_ACCESS_SECRET above. Log in to /platform with these once `npm run prisma:seed` has run.
# SUPER_ADMIN_EMAIL=super-admin@schoolos.dev
# SUPER_ADMIN_PASSWORD=dev-only-change-me-super-admin
