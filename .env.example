# Copy to .env.local for local dev (docker-compose defaults below match docker-compose.yml).
# Never commit a real .env file — secretlint + .gitignore both guard against this, but the rule
# is "never", not "the tools will catch it."

NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://schoolos:schoolos@localhost:5432/schoolos?schema=public
# Only needed against a PgBouncer-fronted database (e.g. Supabase's transaction-pooler
# DATABASE_URL, port 6543) — Prisma Migrate uses this direct/session connection for DDL instead
# (schema.prisma's own `directUrl` doc comment explains why). Point it at the session-mode pooler
# (port 5432) or the true direct connection, never the transaction pooler. Same value as
# DATABASE_URL for local/Docker Postgres, which isn't behind PgBouncer at all.
DIRECT_URL=postgresql://schoolos:schoolos@localhost:5432/schoolos?schema=public
REDIS_URL=redis://localhost:6379

# openssl rand -base64 48 (or equivalent) — real, distinct secrets in every non-local environment,
# stored in a secret manager, never in this file for real.
JWT_ACCESS_SECRET=dev-only-change-me-access
JWT_REFRESH_SECRET=dev-only-change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Comma-separated — must match the frontend's real origin(s), never "*" once cookies are in play
# (security-standards: "CORS: explicit origin allowlist, not *, especially once cookies are in
# play").
CORS_ORIGINS=http://localhost:5173

S3_ENDPOINT=http://localhost:19000
S3_BUCKET=schoolos-documents
S3_ACCESS_KEY_ID=schoolos
S3_SECRET_ACCESS_KEY=schoolos123

# Phase 7.1 — the origin baked into a generated certificate's QR code (its own downstream page
# lives on the frontend, not this API). Matches CORS_ORIGINS above in local dev.
FRONTEND_BASE_URL=http://localhost:5173

# SMTP — invite/reset-password emails and subscription reminder/suspension emails
# (`common/mailer/mailer.service.ts`). Optional: leave unset for local dev/CI and MailerService
# logs a `[dev-only]` line instead of sending, same "log it, don't fail the request" discipline as
# the rest of this file's optional integrations. Set real values to send actual email.
#
# Use a mail-infra provider's SMTP relay here, not Gmail's — raw SMTP to Gmail specifically has
# twice failed outright from this project's Render deploy (ENETUNREACH / connection timeout, live-
# traced both times — see MailerService's own doc comment), a network reachability issue Gmail's
# servers have with Render, not a credentials one. Resend's relay is what this project currently
# uses:
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=re_... (a Resend API key)
# SMTP_FROM=SchoolOS <onboarding@resend.dev>
# ^ resend.dev only delivers to the Resend account's own address until a real sending domain is
# verified (Resend dashboard > Domains) — swap in that domain's address once verified.
# Bounded by connectionTimeout/socketTimeout regardless of provider, so a future unreachable host
# fails fast instead of hanging the request that triggered it.

# Phase 7.9 — `prisma/seed.ts` reads these (not AppConfigService — a seed script, not part of the
# Nest app). Optional: dev-only defaults (`super-admin@schoolos.dev` / `dev-only-change-me-super-
# admin`) apply if unset, same "safe default, real value everywhere but local dev" posture as
# JWT_ACCESS_SECRET above. Log in to /platform with these once `npm run prisma:seed` has run.
# SUPER_ADMIN_EMAIL=super-admin@schoolos.dev
# SUPER_ADMIN_PASSWORD=dev-only-change-me-super-admin
