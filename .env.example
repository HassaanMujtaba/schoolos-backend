# Copy to .env.local for local dev (docker-compose defaults below match docker-compose.yml).
# Never commit a real .env file — secretlint + .gitignore both guard against this, but the rule
# is "never", not "the tools will catch it."

NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://schoolos:schoolos@localhost:5432/schoolos?schema=public
REDIS_URL=redis://localhost:6379

# openssl rand -base64 48 (or equivalent) — real, distinct secrets in every non-local environment,
# stored in a secret manager, never in this file for real.
JWT_ACCESS_SECRET=dev-only-change-me-access
JWT_REFRESH_SECRET=dev-only-change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Comma-separated — must match the frontend's real origin(s), never "*" once cookies are in play
# (security-standards: "CORS: explicit origin allowlist, not *, especially once cookies are in
# play").
CORS_ORIGINS=http://localhost:5173

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=schoolos-documents
S3_ACCESS_KEY_ID=schoolos
S3_SECRET_ACCESS_KEY=schoolos123
