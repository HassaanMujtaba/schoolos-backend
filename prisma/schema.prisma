// SchoolOS backend — Prisma schema.
// Phase 0 (Foundation) + Phase 1 (Auth) + Phase 2 (School Setup & Core Entities).
// See ../implementation-plan.md for what each later phase adds. PRD §45 is the full entity list
// this schema grows toward; PRD §3 governs the tenant/branch shape every later model follows.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy (PRD §3)
// ---------------------------------------------------------------------------

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
}

/// Not itself tenant-scoped (it defines what a tenant *is*) — every other model in this file
/// carries tenantId and is enforced by PrismaService's query extension. Plan/Subscription/Billing
/// (PRD §53, Phase 7.9 Platform Console) get their own models when that phase starts; `plan` here
/// is a placeholder label only.
model Tenant {
  id        String       @id @default(uuid())
  name      String
  slug      String       @unique
  status    TenantStatus @default(TRIAL)
  plan      String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  branches      Branch[]
  users         User[]
  auditLogs     AuditLog[]
  school        School?
  academicYears AcademicYear[]
  classes       SchoolClass[]
  sections      Section[]
  subjects      Subject[]
  parents       Parent[]
  students      Student[]
  teachers      Teacher[]
  admissions    AdmissionApplication[]
  documents     Document[]

  @@map("tenants")
}

/// PRD §6 Branch Management. `campus`/`buildings`/`departments` land in Phase 2's own migration —
/// `frontend/modules/school-setup.md`'s `BranchFormValues` sends buildings/departments as flat
/// `{ name }[]` arrays nested in the branch payload, not their own top-level resources; `Building`/
/// `Department` below are real child tables (so they're queryable/indexed like everything else)
/// but the API surface (`school-setup/branches.controller.ts`) replaces the whole nested list on
/// every branch write, matching that nested-array contract exactly rather than exposing separate
/// CRUD endpoints for them.
model Branch {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  campus    String?
  address   String?
  isMain    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users       User[]
  buildings   Building[]
  departments Department[]

  @@index([tenantId])
  @@map("branches")
}

/// Flat name-list item nested under a Branch — see `Branch`'s own doc comment. Carries its own
/// `tenantId` (duplicated from `branch.tenantId`, same reasoning as `UserRole` above) so
/// `PrismaService`'s tenant-scoping extension can scope it directly without a join.
model Building {
  id       String @id @default(uuid())
  tenantId String
  branchId String
  name     String

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([branchId])
  @@map("buildings")
}

/// See `Building`'s own doc comment — same shape, same reasoning, one per branch/department pair.
model Department {
  id       String @id @default(uuid())
  tenantId String
  branchId String
  name     String

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([branchId])
  @@map("departments")
}

// ---------------------------------------------------------------------------
// Identity & RBAC (PRD §4, §5) — the Phase 1 auth contract is built on these
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED
  INVITED
}

/// One row per person per tenant — PRD §4's role list is not a separate person-type hierarchy,
/// it's `UserRole` grants against this one table. `passwordHash` is bcrypt (never reversible,
/// never logged — security-standards A02).
model User {
  id           String     @id @default(uuid())
  tenantId     String
  branchId     String?
  email        String
  phone        String?
  passwordHash String
  name         String
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  userRoles UserRole[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

/// A fixed, seeded catalog (`prisma/seed.ts`) matching PRD §4's Platform/School role list — not
/// a per-tenant custom-role builder. Revisit if a later phase needs tenant-defined roles.
model Role {
  id       String  @id @default(uuid())
  key      String  @unique
  label    String
  isSystem Boolean @default(true)

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

/// A fixed, seeded catalog matching the permission-string list in
/// ../implementation-plan.md ("Permission catalog") — which is itself collected verbatim from
/// every `frontend/modules/*.md` doc's `RequirePermission`/`can()` usage. Keep this list and that
/// one in sync; they are the same catalog by construction, not two independent ones.
model Permission {
  id    String @id @default(uuid())
  key   String @unique
  label String

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Which roles a user holds *within a given tenant*. Carries its own `tenantId` (derivable via
/// `user.tenantId`, but duplicated here so PrismaService's tenant-scoping extension — which keys
/// off an explicit column, not a joined relation — can scope this model directly).
model UserRole {
  id       String @id @default(uuid())
  tenantId String
  userId   String
  roleId   String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([tenantId])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// School Setup & Core Entities (PRD §6, Phase 2) —
// `frontend/modules/school-setup.md` "Data model / key fields" is the source contract for every
// field below; keep the two in sync.
// ---------------------------------------------------------------------------

/// One row per tenant (§6 School Profile) — not itself a list, so there's no separate "school id"
/// anywhere in the session; the frontend addresses it as `/schools/current`, resolved server-side
/// from the authenticated tenant (see `school-setup.md`'s own "confirm with backend" note, resolved
/// here: keep `/schools/current`, there is still nothing else in the session to address it by).
/// Lazily created on first `GET/PATCH /schools/current` for a tenant that doesn't have one yet
/// (`schools.service.ts`) — there is no tenant-provisioning flow before Phase 7.9's Platform
/// Console, so a row can't be guaranteed to exist by the time this endpoint is first called.
model School {
  id                 String   @id @default(uuid())
  tenantId           String   @unique
  name               String
  email              String   @default("")
  phone              String   @default("")
  website            String   @default("")
  address            String   @default("")
  registrationNumber String   @default("")
  taxInfo            String   @default("")
  /// A plain string, not a Prisma enum, deliberately: `frontend/src/features/school-setup/
  /// schemas.ts`'s `SCHOOL_TYPES` includes hyphenated values (`"higher-secondary"`) that aren't
  /// valid Prisma enum-member identifiers, and an enum's *client-facing* value is always its
  /// member name, not a `@map`-ped alias — there is no way to make a Prisma enum round-trip that
  /// exact string. Validated against `SCHOOL_TYPES` at the application layer instead
  /// (`schools/dto/school.dto.ts`'s `@IsIn`), matching `SubjectType` below's contrasting choice
  /// (no hyphens there, so a real enum works and does).
  schoolType         String   @default("other")
  timezone           String   @default("UTC")
  currency           String   @default("USD")
  language           String   @default("en")
  logoUrl            String   @default("")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("schools")
}

/// §6 Academic Configuration. `terms`/`holidays` are nested arrays in the frontend's own payload
/// shape (`AcademicYearFormValues`), backed here by real child tables for the same reason
/// `Building`/`Department` are — see `Branch`'s doc comment, same pattern applies.
model AcademicYear {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // No stored `isCurrent` column: `AcademicYear` extends `AcademicYearFormValues` (which this
  // model matches) plus a read-only `isCurrent` on the frontend's own `AcademicYear` API type
  // (`features/school-setup/api.ts`), but nothing in the built frontend ever sends a value for it
  // — `AcademicYearTable.tsx` only *displays* the badge, there's no "mark as current" action to
  // wire a mutation endpoint to. `academic-years.service.ts` computes it instead
  // (`startDate <= today <= endDate`), which is both simpler and more accurate than a manually
  // toggled flag that nothing in the product actually toggles.

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  terms    Term[]
  holidays Holiday[]
  students Student[]

  @@index([tenantId])
  @@map("academic_years")
}

model Term {
  id             String   @id @default(uuid())
  tenantId       String
  academicYearId String
  name           String
  startDate      DateTime @db.Date
  endDate        DateTime @db.Date

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([academicYearId])
  @@map("terms")
}

model Holiday {
  id             String   @id @default(uuid())
  tenantId       String
  academicYearId String
  name           String
  date           DateTime @db.Date

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([academicYearId])
  @@map("holidays")
}

/// §6 "Grades/classes" — named `SchoolClass` (not `Class`, a reserved word to avoid tangling with)
/// per `../implementation-plan.md`'s own Phase 2 entity list.
model SchoolClass {
  id         String   @id @default(uuid())
  tenantId   String
  name       String
  gradeLevel Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sections Section[]
  students Student[]

  @@index([tenantId])
  @@map("classes")
}

/// `classTeacherName`/`roomLabel` are free text on purpose — no Teachers or Rooms entity exists
/// yet (`school-setup.md`'s own open question), swap for real foreign keys once Phase 3 (Teachers)
/// and a future Rooms entity land.
model Section {
  id               String   @id @default(uuid())
  tenantId         String
  classId          String
  name             String
  classTeacherName String   @default("")
  roomLabel        String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  students    Student[]

  @@index([tenantId])
  @@index([classId])
  @@map("sections")
}

/// Lowercase member names on purpose — a Prisma enum's client-facing value is its member name
/// verbatim, and `frontend/src/features/school-setup/schemas.ts`'s `SUBJECT_TYPES` is
/// `['core', 'elective', 'optional']`. No hyphens here (unlike `School.schoolType` above), so a
/// real enum can match the frontend's exact strings and still get Postgres-level enforcement.
enum SubjectType {
  core
  elective
  optional
}

/// `classIds` is a plain string array, not a relation table — matches `school-setup.md`'s own data
/// model verbatim ("classIds (string array)"). Referential integrity against `SchoolClass` is
/// enforced in `subjects.service.ts` at write time instead of by a DB foreign key, the trade-off
/// that shape implies; revisit if a real many-to-many join table ever earns its keep.
model Subject {
  id        String      @id @default(uuid())
  tenantId  String
  code      String
  name      String
  type      SubjectType
  classIds  String[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("subjects")
}

// ---------------------------------------------------------------------------
// People (PRD §8/§9/§10, Phase 3) —
// `frontend/modules/students.md` / `parents.md` / `teachers.md` "Data model / key fields" is the
// source contract. Two corrections made against the real frontend source (not just the module
// docs), same discipline as Phase 2's "Phase 2 correction" note:
//
// 1. No separate `Guardian` entity (this schema's earlier draft, and `../implementation-plan.md`'s
//    original Phase 3 entity list, both had one) — `features/parents/api.ts`'s `linkChild` takes a
//    single `relation` string (`ChildLinkPanel.tsx`'s `RELATIONS = ['father', 'mother', 'guardian',
//    'other']`), so "parent" vs. "guardian" is one join table split by `relation`, not two entities.
// 2. No separate `AdmissionInquiry` entity — `features/admissions/api.ts`'s `Admission` is one
//    record carrying a `stage` field through the whole pipeline (inquiry → ... → enrollment), not
//    an inquiry promoted into a distinct application record. Modeled here as one
//    `AdmissionApplication` table.
// ---------------------------------------------------------------------------

enum FamilyRelation {
  father
  mother
  guardian
  other
}

/// §9 Parent Management. `email`/`address` default to `""` rather than nullable — matches
/// `parentSchema`'s always-a-string fields (email is optional *content*, `.or(z.literal(''))`, not
/// an optional *field*).
model Parent {
  id        String   @id @default(uuid())
  tenantId  String
  /// Links this profile to the portal login it belongs to (`GET /parents/me/children`'s "me").
  /// Nullable and unset by anything in this phase — **no endpoint provisions a Parent's portal
  /// User account yet**; `auth.md`'s login flow and this admin-side `POST /parents` are two
  /// separate, currently-unconnected things (creating a Parent profile here doesn't create a
  /// login). `parents.service.ts`'s `getMyChildren` 404s until that provisioning flow exists —
  /// documented as an open gap rather than guessed at, same as Phase 1's identifier-collision note
  /// in `auth.service.ts`.
  userId    String?  @unique
  name      String
  email     String   @default("")
  phone     String
  address   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  links  ParentStudentLink[]

  @@index([tenantId])
  @@map("parents")
}

/// The parent↔student many-to-many, `relation`-typed (see this section's header comment). A
/// student's `parents[]` vs. `guardians[]` (`students.md`'s Family tab) is this same table split by
/// `relation !== 'guardian'` vs. `=== 'guardian'` at read time in `students.service.ts` — there is
/// no separate storage for the two.
model ParentStudentLink {
  id        String         @id @default(uuid())
  tenantId  String
  parentId  String
  studentId String
  relation  FamilyRelation

  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([tenantId])
  @@index([studentId])
  @@map("parent_student_links")
}

enum StudentGender {
  male
  female
  other
}

// PRD §8 doesn't pin an exact enum — matches `STUDENT_STATUSES` in
// `frontend/src/features/students/schemas.ts` exactly (the frontend's own comment there says the
// same: "extend once backend publishes the real values").
enum StudentStatus {
  active
  inactive
  graduated
  transferred
}

/// §8 Student Management — the most-referenced entity in the system (`students.md`'s own framing).
/// `classId`/`sectionId`/`academicYearId` are the student's *current* placement; `enrollments`
/// below is the append-only history `EnrollmentHistoryEntry[]` renders from (see `Enrollment`'s own
/// doc comment). `subjects[]`/`classTeacherId` in the frontend's `Student` type are computed at
/// read time, not stored here — see `students.service.ts`.
model Student {
  id                String        @id @default(uuid())
  tenantId          String
  admissionNumber   String
  name              String
  photoUrl          String?
  dob               DateTime      @db.Date
  gender            StudentGender
  address           String        @default("")
  nationality       String        @default("")
  language          String        @default("")
  classId           String
  sectionId         String
  academicYearId    String
  status            StudentStatus @default(active)
  medicalInfo       String        @default("")
  /// `EmergencyContact[]` (`{ name, relation, phone }`) — a JSON column, not a child table: never
  /// queried/filtered on individually, always read/written as one whole list per
  /// `emergencyContactSchema`'s `useFieldArray` shape, the same call `School`'s free-text fields
  /// make for data nothing in the product searches by.
  emergencyContacts Json          @default("[]")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  schoolClass  SchoolClass         @relation(fields: [classId], references: [id])
  section      Section             @relation(fields: [sectionId], references: [id])
  academicYear AcademicYear        @relation(fields: [academicYearId], references: [id])
  enrollments  Enrollment[]
  familyLinks  ParentStudentLink[]

  @@unique([tenantId, admissionNumber])
  @@index([tenantId])
  @@index([classId])
  @@index([sectionId])
  @@map("students")
}

/// Append-only snapshot written every time a `Student`'s class/section/academic year changes
/// (including the row created alongside the student itself) — `students.md`'s
/// `enrollmentHistory: EnrollmentHistoryEntry[]`. Never updated or deleted, only inserted;
/// `students.service.ts` is the only writer.
model Enrollment {
  id             String   @id @default(uuid())
  tenantId       String
  studentId      String
  academicYearId String
  classId        String
  sectionId      String
  createdAt      DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([studentId])
  @@map("enrollments")
}

/// §10 Teacher Management. `subjectIds` is a plain string array, same trade-off as `Subject.
/// classIds` (referential integrity enforced in `teachers.service.ts`, not a DB foreign key) — the
/// subjects a teacher is generally qualified to teach, distinct from `TeacherAssignment` below
/// (the actual subject/class/section timetable assignment).
model Teacher {
  id              String   @id @default(uuid())
  tenantId        String
  name            String
  email           String   @default("")
  phone           String   @default("")
  employeeId      String
  experienceYears Int?
  /// `Qualification[]` (`{ degree, institution, year }`) — JSON, same reasoning as `Student.
  /// emergencyContacts`.
  qualifications  Json     @default("[]")
  subjectIds      String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignments TeacherAssignment[]

  @@unique([tenantId, employeeId])
  @@index([tenantId])
  @@map("teachers")
}

/// `Assignment { teacherId, subjectId, classId, sectionId }` per `teachers.md`'s data model —
/// subject/class/section referential integrity enforced at the application layer
/// (`teachers.service.ts`), same `classIds`/`subjectIds` trade-off as above.
model TeacherAssignment {
  id        String @id @default(uuid())
  tenantId  String
  teacherId String
  subjectId String
  classId   String
  sectionId String

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([teacherId])
  @@map("teacher_assignments")
}

// Order matters — the pipeline sequence itself, matching `ADMISSION_STAGES` in
// `frontend/src/features/admissions/schemas.ts` verbatim.
enum AdmissionStage {
  inquiry
  application
  documents
  review
  entrance_test
  interview
  acceptance
  fee_payment
  enrollment
}

enum AdmissionDecision {
  pending
  accepted
  rejected
  waitlisted
}

/// §7 Admission Management — one record for the whole pipeline (see this section's header
/// comment). `admissionFeeInvoiceId` stays `null` until Phase 6 (Finance) exists — see
/// `../implementation-plan.md`'s resolved admissions↔fees ordering decision; `enrolledStudentId` is
/// set by `POST /admissions/:id/enroll` once the `Student` row is created. Neither is a real Prisma
/// relation (both point at rows that may not exist yet, or at a model — `Invoice` — that doesn't
/// exist in this schema until Phase 6), so both stay plain nullable id columns.
model AdmissionApplication {
  id                    String            @id @default(uuid())
  tenantId              String
  stage                 AdmissionStage    @default(inquiry)
  applicantName         String
  applicantDob          DateTime          @db.Date
  /// A `SchoolClass` id, not free text (`InquiryForm.tsx`'s `classAppliedFor` is a `<Select>` over
  /// real classes) — validated against `SchoolClass` in `admissions.service.ts` at write time, same
  /// `classIds`/`subjectIds` no-DB-foreign-key trade-off as `Subject`/`Teacher` above.
  classAppliedFor       String
  contactPhone          String
  contactEmail          String            @default("")
  address               String            @default("")
  previousSchool        String            @default("")
  notes                 String            @default("")
  entranceTestScore     Float?
  interviewNotes        String            @default("")
  applicationScore      Float?
  decision              AdmissionDecision @default(pending)
  decisionReason        String            @default("")
  /// Placeholder file-name list only — `PATCH /admissions/:id/documents` doesn't perform a real
  /// upload yet (`admissions/api.ts`'s own comment: no confirmed `POST /documents/upload` at the
  /// time it was built). Real `Document` rows (category `admission`, `ownerId` = this application's
  /// id — already available from the `inquiry` stage on, no two-step upload-before-owner-exists
  /// problem for this consumer, unlike Students) are a frontend-wiring follow-up once
  /// `DocumentsPanel` moves off this placeholder, not a schema change.
  documentNames         String[]          @default([])
  admissionFeeInvoiceId String?
  enrolledStudentId     String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([stage])
  @@map("admission_applications")
}

// ---------------------------------------------------------------------------
// Documents (PRD §31, Phase 3 — build early per `../implementation-plan.md`; the dedicated browse/
// search library and certificates half are Phase 7.1) —
// `frontend/modules/documents-certificates.md` "Backend dependencies" is the source contract.
// ---------------------------------------------------------------------------

enum DocumentCategory {
  admission
  student
  employee
  medical
  contract
  certificate
  report
}

/// The owning record (one per logical file); `versions` below holds the actual content pointers.
/// `ownerId`/`ownerLabel` are nullable free text, not a relation — matches
/// `documentUploadSchema`'s optional fields exactly (`documents/schemas.ts`'s own comment: not
/// worth coupling a generic cross-category store to five other features' id spaces). A `null`
/// `ownerId` is the two-step-upload case (`../implementation-plan.md`'s Phase 3 problem #2) — the
/// owning entity didn't exist yet when the file was picked; a follow-up `PATCH /documents/:id`
/// attaches it once it does.
model Document {
  id         String           @id @default(uuid())
  tenantId   String
  category   DocumentCategory
  ownerId    String?
  ownerLabel String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions DocumentVersion[]

  @@index([tenantId])
  @@index([category])
  @@index([ownerId])
  @@map("documents")
}

/// One row per uploaded version (`GET /documents/:id/versions`). Phase 3 only ever writes version
/// 1 (`POST /documents/upload` always creates a new `Document`); a real "upload a new version of
/// this existing document" action is Phase 7.1's — this table already supports it without a schema
/// change. `storageKey` is the S3/MinIO object key, never returned to a client directly — every
/// read goes through `StorageService`'s presigned-URL generation (`documents.service.ts`).
model DocumentVersion {
  id               String   @id @default(uuid())
  tenantId         String
  documentId       String
  version          Int
  fileName         String
  mimeType         String
  sizeBytes        Int
  storageKey       String
  /// Plain id, no Prisma relation — same `actorUserId` pattern `AuditLog` already uses, so a
  /// document version outlives a deleted `User` and still has `uploadedByLabel` (a denormalized
  /// display name/email snapshot) to say who it was.
  uploadedByUserId String?
  uploadedByLabel  String
  createdAt        DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@index([tenantId])
  @@map("document_versions")
}

// ---------------------------------------------------------------------------
// Audit (PRD §43)
// ---------------------------------------------------------------------------

/// Written by `AuditInterceptor` (generic) and, for anything needing a real before/after diff, by
/// feature services directly. No `onDelete: Cascade` relation to `User` for `actorUserId` on
/// purpose — an audit trail must survive the actor's own record being removed later, so it's a
/// plain string, not a enforced foreign key.
///
/// Append-only in practice, not just by convention: the deploy migration for this table should
/// grant the application's runtime DB role INSERT/SELECT only, never UPDATE/DELETE — track that
/// as an infra task alongside this model, not something Prisma's schema can express on its own.
model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  oldValue    Json?
  newValue    Json?
  ip          String?
  userAgent   String?
  requestId   String?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}
