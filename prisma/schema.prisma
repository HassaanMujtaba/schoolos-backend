// SchoolOS backend — Prisma schema.
// Phase 0 (Foundation) + Phase 1 (Auth) + Phase 2 (School Setup & Core Entities).
// See ../implementation-plan.md for what each later phase adds. PRD §45 is the full entity list
// this schema grows toward; PRD §3 governs the tenant/branch shape every later model follows.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Prisma Migrate needs a direct (non-transaction-pooled) connection — PgBouncer's transaction
  // pooling mode (what DATABASE_URL points at in production, Supabase port 6543) doesn't reliably
  // support the DDL Migrate runs, `ALTER TYPE ... ADD VALUE` in particular (confirmed the hard way:
  // it's what took production down on 2026-09-16 — the migration failed on its very first
  // statement, `applied_steps_count: 0`, nothing else was touched). `directUrl` is Prisma's own
  // documented fix for exactly this Supabase/PgBouncer shape: the CLI (migrate/db push/introspect)
  // uses this one, `PrismaClient` at runtime keeps using the pooled `url` above unchanged. Point
  // it at Supabase's session-mode pooler (port 5432) or the true direct connection, never 6543.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Tenancy (PRD §3)
// ---------------------------------------------------------------------------

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
}

/// Not itself tenant-scoped (it defines what a tenant *is*) — every other model in this file
/// carries tenantId and is enforced by PrismaService's query extension. `plan` below is a
/// leftover placeholder label from before Phase 7.9 added the real `Plan`/`Subscription`/
/// `BillingRecord` models (see this file's own "Platform Console" section near the bottom) —
/// nothing reads it (`grep` turned up zero call sites when that phase started); kept rather than
/// migrated away since dropping a column nobody populated yet is lower-risk than a data migration
/// nobody's read path depends on either way.
model Tenant {
  id        String       @id @default(uuid())
  name      String
  slug      String       @unique
  status    TenantStatus @default(TRIAL)
  plan      String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  branches          Branch[]
  users             User[]
  auditLogs         AuditLog[]
  school            School?
  academicYears     AcademicYear[]
  classes           SchoolClass[]
  sections          Section[]
  subjects          Subject[]
  parents           Parent[]
  students          Student[]
  teachers          Teacher[]
  admissions        AdmissionApplication[]
  documents         Document[]
  timetableEntries  TimetableEntry[]
  substitutions     Substitution[]
  homework          Homework[]
  exams             Exam[]
  feeStructures     FeeStructure[]
  invoices          Invoice[]
  certificates      Certificate[]
  libraryCategories LibraryCategory[]
  libraryShelves    LibraryShelf[]
  libraryBooks      Book[]
  libraryMembers    LibraryMember[]
  librarySettings   LibrarySettings?
  vehicles          Vehicle[]
  routes            Route[]
  stockCategories   StockCategory[]
  stockItems        StockItem[]
  assets            Asset[]
  hostels           Hostel[]
  hostelRooms       Room[]
  hostelAllocations Allocation[]
  hostelComplaints  Complaint[]
  employees         Employee[]
  payrollPeriods    PayrollPeriod[]
  messageThreads    MessageThread[]
  announcements     Announcement[]
  events            Event[]
  ptmSlots          PtmSlot[]
  // Phase 7.9 — Platform Console. Real FKs (unlike FeatureFlag/PlatformAuditLog below, which
  // denormalize tenantId/tenantName as plain fields instead) because these two are queried
  // together with live Tenant/School data on every list view, not read back as a historical
  // snapshot — see this file's own "Platform Console" section for the full reasoning.
  subscription      Subscription?
  billingRecords    BillingRecord[]

  @@map("tenants")
}

/// PRD §6 Branch Management. `campus`/`buildings`/`departments` land in Phase 2's own migration —
/// `frontend/modules/school-setup.md`'s `BranchFormValues` sends buildings/departments as flat
/// `{ name }[]` arrays nested in the branch payload, not their own top-level resources; `Building`/
/// `Department` below are real child tables (so they're queryable/indexed like everything else)
/// but the API surface (`school-setup/branches.controller.ts`) replaces the whole nested list on
/// every branch write, matching that nested-array contract exactly rather than exposing separate
/// CRUD endpoints for them.
model Branch {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  campus    String?
  address   String?
  isMain    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users       User[]
  buildings   Building[]
  departments Department[]

  @@index([tenantId])
  @@map("branches")
}

/// Flat name-list item nested under a Branch — see `Branch`'s own doc comment. Carries its own
/// `tenantId` (duplicated from `branch.tenantId`, same reasoning as `UserRole` above) so
/// `PrismaService`'s tenant-scoping extension can scope it directly without a join.
model Building {
  id       String @id @default(uuid())
  tenantId String
  branchId String
  name     String

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([branchId])
  @@map("buildings")
}

/// See `Building`'s own doc comment — same shape, same reasoning, one per branch/department pair.
model Department {
  id       String @id @default(uuid())
  tenantId String
  branchId String
  name     String

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([branchId])
  @@map("departments")
}

// ---------------------------------------------------------------------------
// Identity & RBAC (PRD §4, §5) — the Phase 1 auth contract is built on these
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED
  INVITED
}

/// One row per person per tenant — PRD §4's role list is not a separate person-type hierarchy,
/// it's `UserRole` grants against this one table. `passwordHash` is bcrypt (never reversible,
/// never logged — security-standards A02).
model User {
  id           String     @id @default(uuid())
  tenantId     String
  branchId     String?
  email        String
  phone        String?
  passwordHash String
  name         String
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  userRoles UserRole[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

/// A fixed, seeded catalog (`prisma/seed.ts`) matching PRD §4's Platform/School role list — not
/// a per-tenant custom-role builder. Revisit if a later phase needs tenant-defined roles.
model Role {
  id       String  @id @default(uuid())
  key      String  @unique
  label    String
  isSystem Boolean @default(true)

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

/// A fixed, seeded catalog matching the permission-string list in
/// ../implementation-plan.md ("Permission catalog") — which is itself collected verbatim from
/// every `frontend/modules/*.md` doc's `RequirePermission`/`can()` usage. Keep this list and that
/// one in sync; they are the same catalog by construction, not two independent ones.
model Permission {
  id    String @id @default(uuid())
  key   String @unique
  label String

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Which roles a user holds *within a given tenant*. Carries its own `tenantId` (derivable via
/// `user.tenantId`, but duplicated here so PrismaService's tenant-scoping extension — which keys
/// off an explicit column, not a joined relation — can scope this model directly).
model UserRole {
  id       String @id @default(uuid())
  tenantId String
  userId   String
  roleId   String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([tenantId])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// School Setup & Core Entities (PRD §6, Phase 2) —
// `frontend/modules/school-setup.md` "Data model / key fields" is the source contract for every
// field below; keep the two in sync.
// ---------------------------------------------------------------------------

/// One row per tenant (§6 School Profile) — not itself a list, so there's no separate "school id"
/// anywhere in the session; the frontend addresses it as `/schools/current`, resolved server-side
/// from the authenticated tenant (see `school-setup.md`'s own "confirm with backend" note, resolved
/// here: keep `/schools/current`, there is still nothing else in the session to address it by).
/// Lazily created on first `GET/PATCH /schools/current` for a tenant that doesn't have one yet
/// (`schools.service.ts`) — there is no tenant-provisioning flow before Phase 7.9's Platform
/// Console, so a row can't be guaranteed to exist by the time this endpoint is first called.
model School {
  id                 String   @id @default(uuid())
  tenantId           String   @unique
  name               String
  email              String   @default("")
  phone              String   @default("")
  website            String   @default("")
  address            String   @default("")
  registrationNumber String   @default("")
  taxInfo            String   @default("")
  /// A plain string, not a Prisma enum, deliberately: `frontend/src/features/school-setup/
  /// schemas.ts`'s `SCHOOL_TYPES` includes hyphenated values (`"higher-secondary"`) that aren't
  /// valid Prisma enum-member identifiers, and an enum's *client-facing* value is always its
  /// member name, not a `@map`-ped alias — there is no way to make a Prisma enum round-trip that
  /// exact string. Validated against `SCHOOL_TYPES` at the application layer instead
  /// (`schools/dto/school.dto.ts`'s `@IsIn`), matching `SubjectType` below's contrasting choice
  /// (no hyphens there, so a real enum works and does).
  schoolType         String   @default("other")
  timezone           String   @default("Asia/Karachi")
  currency           String   @default("PKR")
  language           String   @default("en")
  logoUrl            String   @default("")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("schools")
}

/// §6 Academic Configuration. `terms`/`holidays` are nested arrays in the frontend's own payload
/// shape (`AcademicYearFormValues`), backed here by real child tables for the same reason
/// `Building`/`Department` are — see `Branch`'s doc comment, same pattern applies.
model AcademicYear {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // No stored `isCurrent` column: `AcademicYear` extends `AcademicYearFormValues` (which this
  // model matches) plus a read-only `isCurrent` on the frontend's own `AcademicYear` API type
  // (`features/school-setup/api.ts`), but nothing in the built frontend ever sends a value for it
  // — `AcademicYearTable.tsx` only *displays* the badge, there's no "mark as current" action to
  // wire a mutation endpoint to. `academic-years.service.ts` computes it instead
  // (`startDate <= today <= endDate`), which is both simpler and more accurate than a manually
  // toggled flag that nothing in the product actually toggles.

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  terms    Term[]
  holidays Holiday[]
  students Student[]

  @@index([tenantId])
  @@map("academic_years")
}

model Term {
  id             String   @id @default(uuid())
  tenantId       String
  academicYearId String
  name           String
  startDate      DateTime @db.Date
  endDate        DateTime @db.Date

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([academicYearId])
  @@map("terms")
}

model Holiday {
  id             String   @id @default(uuid())
  tenantId       String
  academicYearId String
  name           String
  date           DateTime @db.Date

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([academicYearId])
  @@map("holidays")
}

/// §6 "Grades/classes" — named `SchoolClass` (not `Class`, a reserved word to avoid tangling with)
/// per `../implementation-plan.md`'s own Phase 2 entity list.
model SchoolClass {
  id         String   @id @default(uuid())
  tenantId   String
  name       String
  gradeLevel Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sections Section[]
  students Student[]

  @@index([tenantId])
  @@map("classes")
}

/// `classTeacherName`/`roomLabel` are free text on purpose — no Teachers or Rooms entity exists
/// yet (`school-setup.md`'s own open question), swap for real foreign keys once Phase 3 (Teachers)
/// and a future Rooms entity land.
model Section {
  id               String   @id @default(uuid())
  tenantId         String
  classId          String
  name             String
  classTeacherName String   @default("")
  roomLabel        String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  students    Student[]

  @@index([tenantId])
  @@index([classId])
  @@map("sections")
}

/// Lowercase member names on purpose — a Prisma enum's client-facing value is its member name
/// verbatim, and `frontend/src/features/school-setup/schemas.ts`'s `SUBJECT_TYPES` is
/// `['core', 'elective', 'optional']`. No hyphens here (unlike `School.schoolType` above), so a
/// real enum can match the frontend's exact strings and still get Postgres-level enforcement.
enum SubjectType {
  core
  elective
  optional
}

/// `classIds` is a plain string array, not a relation table — matches `school-setup.md`'s own data
/// model verbatim ("classIds (string array)"). Referential integrity against `SchoolClass` is
/// enforced in `subjects.service.ts` at write time instead of by a DB foreign key, the trade-off
/// that shape implies; revisit if a real many-to-many join table ever earns its keep.
model Subject {
  id        String      @id @default(uuid())
  tenantId  String
  code      String
  name      String
  type      SubjectType
  classIds  String[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("subjects")
}

// ---------------------------------------------------------------------------
// People (PRD §8/§9/§10, Phase 3) —
// `frontend/modules/students.md` / `parents.md` / `teachers.md` "Data model / key fields" is the
// source contract. Two corrections made against the real frontend source (not just the module
// docs), same discipline as Phase 2's "Phase 2 correction" note:
//
// 1. No separate `Guardian` entity (this schema's earlier draft, and `../implementation-plan.md`'s
//    original Phase 3 entity list, both had one) — `features/parents/api.ts`'s `linkChild` takes a
//    single `relation` string (`ChildLinkPanel.tsx`'s `RELATIONS = ['father', 'mother', 'guardian',
//    'other']`), so "parent" vs. "guardian" is one join table split by `relation`, not two entities.
// 2. No separate `AdmissionInquiry` entity — `features/admissions/api.ts`'s `Admission` is one
//    record carrying a `stage` field through the whole pipeline (inquiry → ... → enrollment), not
//    an inquiry promoted into a distinct application record. Modeled here as one
//    `AdmissionApplication` table.
// ---------------------------------------------------------------------------

enum FamilyRelation {
  father
  mother
  guardian
  other
}

/// §9 Parent Management. `email`/`address` default to `""` rather than nullable — matches
/// `parentSchema`'s always-a-string fields (email is optional *content*, `.or(z.literal(''))`, not
/// an optional *field*).
model Parent {
  id        String   @id @default(uuid())
  tenantId  String
  /// Links this profile to the portal login it belongs to (`GET /parents/me/children`'s "me").
  /// Nullable and unset by anything in this phase — **no endpoint provisions a Parent's portal
  /// User account yet**; `auth.md`'s login flow and this admin-side `POST /parents` are two
  /// separate, currently-unconnected things (creating a Parent profile here doesn't create a
  /// login). `parents.service.ts`'s `getMyChildren` 404s until that provisioning flow exists —
  /// documented as an open gap rather than guessed at, same as Phase 1's identifier-collision note
  /// in `auth.service.ts`.
  userId    String?  @unique
  name      String
  email     String   @default("")
  phone     String
  address   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  links  ParentStudentLink[]

  @@index([tenantId])
  @@map("parents")
}

/// The parent↔student many-to-many, `relation`-typed (see this section's header comment). A
/// student's `parents[]` vs. `guardians[]` (`students.md`'s Family tab) is this same table split by
/// `relation !== 'guardian'` vs. `=== 'guardian'` at read time in `students.service.ts` — there is
/// no separate storage for the two.
model ParentStudentLink {
  id        String         @id @default(uuid())
  tenantId  String
  parentId  String
  studentId String
  relation  FamilyRelation

  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([tenantId])
  @@index([studentId])
  @@map("parent_student_links")
}

enum StudentGender {
  male
  female
  other
}

// PRD §8 doesn't pin an exact enum — matches `STUDENT_STATUSES` in
// `frontend/src/features/students/schemas.ts` exactly (the frontend's own comment there says the
// same: "extend once backend publishes the real values").
enum StudentStatus {
  active
  inactive
  graduated
  transferred
}

/// §8 Student Management — the most-referenced entity in the system (`students.md`'s own framing).
/// `classId`/`sectionId`/`academicYearId` are the student's *current* placement; `enrollments`
/// below is the append-only history `EnrollmentHistoryEntry[]` renders from (see `Enrollment`'s own
/// doc comment). `subjects[]`/`classTeacherId` in the frontend's `Student` type are computed at
/// read time, not stored here — see `students.service.ts`.
model Student {
  id                String        @id @default(uuid())
  tenantId          String
  admissionNumber   String
  name              String
  photoUrl          String?
  dob               DateTime      @db.Date
  gender            StudentGender
  address           String        @default("")
  nationality       String        @default("")
  language          String        @default("")
  classId           String
  sectionId         String
  academicYearId    String
  status            StudentStatus @default(active)
  medicalInfo       String        @default("")
  /// Links this profile to the portal login it belongs to — the same `Parent.userId` idiom
  /// (`../../implementation-plan.md`'s Phase 4 "`me` idiom" convention: `studentId=me` on
  /// attendance/homework resolves via this column). Nullable and unset by anything through Phase
  /// 4 — same documented gap as `Parent.userId`, no student-portal-invite flow exists yet, so
  /// every `studentId=me` call 404s until one does; this needs no change once it exists.
  userId            String?       @unique
  /// `EmergencyContact[]` (`{ name, relation, phone }`) — a JSON column, not a child table: never
  /// queried/filtered on individually, always read/written as one whole list per
  /// `emergencyContactSchema`'s `useFieldArray` shape, the same call `School`'s free-text fields
  /// make for data nothing in the product searches by.
  emergencyContacts Json          @default("[]")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  schoolClass         SchoolClass          @relation(fields: [classId], references: [id])
  section             Section              @relation(fields: [sectionId], references: [id])
  academicYear        AcademicYear         @relation(fields: [academicYearId], references: [id])
  enrollments         Enrollment[]
  familyLinks         ParentStudentLink[]
  attendanceRecords   AttendanceRecord[]
  leaveRequests       LeaveRequest[]
  homeworkSubmissions HomeworkSubmission[]
  examMarks           ExamMark[]
  invoices            Invoice[]
  certificates        Certificate[]

  @@unique([tenantId, admissionNumber])
  @@index([tenantId])
  @@index([classId])
  @@index([sectionId])
  @@map("students")
}

/// Append-only snapshot written every time a `Student`'s class/section/academic year changes
/// (including the row created alongside the student itself) — `students.md`'s
/// `enrollmentHistory: EnrollmentHistoryEntry[]`. Never updated or deleted, only inserted;
/// `students.service.ts` is the only writer.
model Enrollment {
  id             String   @id @default(uuid())
  tenantId       String
  studentId      String
  academicYearId String
  classId        String
  sectionId      String
  createdAt      DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([studentId])
  @@map("enrollments")
}

/// §10 Teacher Management. `subjectIds` is a plain string array, same trade-off as `Subject.
/// classIds` (referential integrity enforced in `teachers.service.ts`, not a DB foreign key) — the
/// subjects a teacher is generally qualified to teach, distinct from `TeacherAssignment` below
/// (the actual subject/class/section timetable assignment).
model Teacher {
  id              String   @id @default(uuid())
  tenantId        String
  name            String
  email           String   @default("")
  phone           String   @default("")
  employeeId      String
  experienceYears Int?
  /// `Qualification[]` (`{ degree, institution, year }`) — JSON, same reasoning as `Student.
  /// emergencyContacts`.
  qualifications  Json     @default("[]")
  subjectIds      String[]
  /// Links this profile to the portal login it belongs to — same `Parent.userId`/`Student.userId`
  /// idiom (`teacherId=me` on `GET /timetable`). Same documented gap: nullable, unset by anything
  /// through Phase 4, 404s until a teacher-portal-invite flow provisions it.
  userId          String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignments    TeacherAssignment[]
  /// Reverse side of `Employee.teacherId` (Phase 7.6) — the real teacher↔employee link, see that
  /// field's own doc comment. No FK columns on this side; Prisma requires the reverse relation
  /// field to be declared even though the foreign key itself lives on `Employee`.
  employeeRecord Employee?
  /// Reverse side of `PtmSlot.teacherId` (Phase 7.7) — see that field's own doc comment.
  ptmSlots       PtmSlot[]

  @@unique([tenantId, employeeId])
  @@index([tenantId])
  @@map("teachers")
}

/// `Assignment { teacherId, subjectId, classId, sectionId }` per `teachers.md`'s data model —
/// subject/class/section referential integrity enforced at the application layer
/// (`teachers.service.ts`), same `classIds`/`subjectIds` trade-off as above.
model TeacherAssignment {
  id        String @id @default(uuid())
  tenantId  String
  teacherId String
  subjectId String
  classId   String
  sectionId String

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([teacherId])
  @@map("teacher_assignments")
}

// Order matters — the pipeline sequence itself, matching `ADMISSION_STAGES` in
// `frontend/src/features/admissions/schemas.ts` verbatim.
enum AdmissionStage {
  inquiry
  application
  documents
  review
  entrance_test
  interview
  acceptance
  fee_payment
  enrollment
}

enum AdmissionDecision {
  pending
  accepted
  rejected
  waitlisted
}

/// §7 Admission Management — one record for the whole pipeline (see this section's header
/// comment). `admissionFeeInvoiceId` stays `null` until Phase 6 (Finance) exists — see
/// `../implementation-plan.md`'s resolved admissions↔fees ordering decision; `enrolledStudentId` is
/// set by `POST /admissions/:id/enroll` once the `Student` row is created. Neither is a real Prisma
/// relation (both point at rows that may not exist yet, or at a model — `Invoice` — that doesn't
/// exist in this schema until Phase 6), so both stay plain nullable id columns.
model AdmissionApplication {
  id                    String            @id @default(uuid())
  tenantId              String
  stage                 AdmissionStage    @default(inquiry)
  applicantName         String
  applicantDob          DateTime          @db.Date
  /// A `SchoolClass` id, not free text (`InquiryForm.tsx`'s `classAppliedFor` is a `<Select>` over
  /// real classes) — validated against `SchoolClass` in `admissions.service.ts` at write time, same
  /// `classIds`/`subjectIds` no-DB-foreign-key trade-off as `Subject`/`Teacher` above.
  classAppliedFor       String
  contactPhone          String
  contactEmail          String            @default("")
  address               String            @default("")
  previousSchool        String            @default("")
  notes                 String            @default("")
  entranceTestScore     Float?
  interviewNotes        String            @default("")
  applicationScore      Float?
  decision              AdmissionDecision @default(pending)
  decisionReason        String            @default("")
  /// Placeholder file-name list only — `PATCH /admissions/:id/documents` doesn't perform a real
  /// upload yet (`admissions/api.ts`'s own comment: no confirmed `POST /documents/upload` at the
  /// time it was built). Real `Document` rows (category `admission`, `ownerId` = this application's
  /// id — already available from the `inquiry` stage on, no two-step upload-before-owner-exists
  /// problem for this consumer, unlike Students) are a frontend-wiring follow-up once
  /// `DocumentsPanel` moves off this placeholder, not a schema change.
  documentNames         String[]          @default([])
  /// Still a plain id column, not a Prisma relation — unlike `Invoice.admissionApplicationId`
  /// below (a real FK, since `AdmissionApplication` already existed when `Invoice` was added in
  /// Phase 6), this field predates `Invoice`'s existence (Phase 3) and nothing in Phase 6's scope
  /// calls for converting it; `invoices` below is the queryable side of that relationship.
  admissionFeeInvoiceId String?
  enrolledStudentId     String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([tenantId])
  @@index([stage])
  @@map("admission_applications")
}

// ---------------------------------------------------------------------------
// Documents (PRD §31, Phase 3 — build early per `../implementation-plan.md`; the dedicated browse/
// search library and certificates half are Phase 7.1) —
// `frontend/modules/documents-certificates.md` "Backend dependencies" is the source contract.
// ---------------------------------------------------------------------------

enum DocumentCategory {
  admission
  student
  employee
  medical
  contract
  certificate
  report
  // Phase 7.3 — Transport. `VehicleForm`'s documents tab is still client-side-only (nothing
  // submits through `POST /documents/upload` yet, `../implementation-plan.md`'s Phase 7.3 own
  // note), but `Vehicle.documents` resolves the same real way `Student.documents` already does
  // (category + ownerId), so wiring the frontend up later is additive, not a schema change.
  vehicle
}

/// The owning record (one per logical file); `versions` below holds the actual content pointers.
/// `ownerId`/`ownerLabel` are nullable free text, not a relation — matches
/// `documentUploadSchema`'s optional fields exactly (`documents/schemas.ts`'s own comment: not
/// worth coupling a generic cross-category store to five other features' id spaces). A `null`
/// `ownerId` is the two-step-upload case (`../implementation-plan.md`'s Phase 3 problem #2) — the
/// owning entity didn't exist yet when the file was picked; a follow-up `PATCH /documents/:id`
/// attaches it once it does.
model Document {
  id         String           @id @default(uuid())
  tenantId   String
  category   DocumentCategory
  ownerId    String?
  ownerLabel String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions DocumentVersion[]

  @@index([tenantId])
  @@index([category])
  @@index([ownerId])
  @@map("documents")
}

/// One row per uploaded version (`GET /documents/:id/versions`). Phase 3 only ever writes version
/// 1 (`POST /documents/upload` always creates a new `Document`); a real "upload a new version of
/// this existing document" action is Phase 7.1's — this table already supports it without a schema
/// change. `storageKey` is the S3/MinIO object key, never returned to a client directly — every
/// read goes through `StorageService`'s presigned-URL generation (`documents.service.ts`).
model DocumentVersion {
  id               String   @id @default(uuid())
  tenantId         String
  documentId       String
  version          Int
  fileName         String
  mimeType         String
  sizeBytes        Int
  storageKey       String
  /// Plain id, no Prisma relation — same `actorUserId` pattern `AuditLog` already uses, so a
  /// document version outlives a deleted `User` and still has `uploadedByLabel` (a denormalized
  /// display name/email snapshot) to say who it was.
  uploadedByUserId String?
  uploadedByLabel  String
  createdAt        DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@index([tenantId])
  @@map("document_versions")
}

/// §32 Certificate templates — `frontend/src/features/certificates/schemas.ts`'s
/// `CERTIFICATE_TEMPLATES`, same lowercase-enum-member-matches-frontend-string convention as
/// `FeeType`/`SubjectType`.
enum CertificateTemplate {
  bonafide
  enrollment
  character
  transfer
  leaving
  achievement
  custom
}

/// §32 Certificates — one row per generated certificate, the PDF itself lives in object storage
/// (`storageKey`, same never-store-a-directly-fetchable-URL discipline `DocumentVersion` already
/// established — every read resolves a fresh presigned `pdfUrl` via `StorageService`).
///
/// `certificateNumber` (human-displayed, printed on the PDF, unique per tenant) and `verifyCode`
/// (the opaque token embedded in the QR / used as `GET /certificates/verify/:code`'s path param)
/// are deliberately two different values, not one — `verifyCode` is generated with more entropy
/// (`certificates.service.ts`'s own comment) since, unlike `certificateNumber`, it's the only
/// thing standing between "anyone with this code can read this certificate's holder name with no
/// login" and a real access control — see the verify endpoint's own doc comment for why that
/// lookup is a public, cross-tenant `PlatformPrismaService` read (no per-request tenant exists for
/// an unauthenticated QR scan), a third sanctioned call site alongside the two
/// `platform-prisma.service.ts` already documents.
///
/// `fields` is the template's dynamic-field values (`Record<string,string>`, keyed by
/// `CERTIFICATE_TEMPLATE_FIELDS`' `key`s) — display-only JSON, same trade-off as
/// `Invoice.lineItems`, since these are baked into the rendered PDF at generation time and never
/// recomputed. `title` is server-derived at generation time (the template's display label, or
/// `customTitle` for `custom`) — never trusted from the client for the same reason
/// `studentLabel`/`schoolName` in the verify response are always re-resolved from the real
/// `Student`/`School` rows, not persisted from the generate request.
model Certificate {
  id                String              @id @default(uuid())
  tenantId          String
  studentId         String
  template          CertificateTemplate
  title             String
  fields            Json                @default("{}")
  certificateNumber String
  verifyCode        String              @unique
  storageKey        String
  generatedByUserId String?
  generatedByLabel  String
  createdAt         DateTime            @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id])

  @@unique([tenantId, certificateNumber])
  @@index([tenantId])
  @@index([studentId])
  @@map("certificates")
}

// ---------------------------------------------------------------------------
// Academics (PRD §12/§13/§14/§15, Phase 4) —
// `frontend/modules/timetable.md` / `attendance.md` / `homework.md` "Backend dependencies" is the
// source contract. One correction against the real frontend source, same discipline as every
// earlier phase's own correction note — see `../implementation-plan.md`'s "Phase 4 correction":
// the permission catalog's `timetable.manage`/`timetable.generate` and `homework.manage` buckets
// are replaced below by the granular strings the actually-built frontend calls (`timetable.update`
// for all of timetable's editing/generation/substitution actions;
// `homework.create`/`.update`/`.delete` for homework's CRUD, `homework.grade` kept for grading).
//
// No separate `Timetable` header entity (`../implementation-plan.md`'s original Phase 4 entity
// list had one) — `frontend/src/features/timetable/api.ts`'s `TimetableEntry` is the only shape
// ever fetched or written, same "no separate aggregate entity" correction as Phase 3's
// `AdmissionInquiry`.
// ---------------------------------------------------------------------------

/// §12 Timetable Management — one flat table of scheduled periods. `roomId` stays free text, same
/// as `Section.roomLabel` — no Room entity yet (`school-setup.md`'s own open question, unchanged
/// by this phase). `classId`/`sectionId`/`subjectId`/`teacherId` are plain ids, not Prisma
/// relations — same "peer entity, no ownership hierarchy" trade-off as `TeacherAssignment`'s own
/// fields, validated at the application layer (`timetable.service.ts`) instead of by a DB foreign
/// key.
model TimetableEntry {
  id          String   @id @default(uuid())
  tenantId    String
  classId     String
  sectionId   String
  subjectId   String
  teacherId   String
  roomId      String   @default("")
  /// 0 = Monday, per `frontend/src/features/timetable/constants.ts`'s `WEEKDAYS` — matches the
  /// frontend's own convention exactly, not ISO-8601's 1 = Monday. Assumes a Monday–Saturday
  /// six-day week (0-5), unconfirmed with product — see `timetable.md`'s own "Open questions".
  dayOfWeek   Int
  periodIndex Int
  startTime   String
  endTime     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([classId, sectionId])
  @@index([teacherId])
  @@map("timetable_entries")
}

/// A manual, per-date override of who teaches a class's period — not a recurring
/// `TimetableEntry`. `originalTeacherId`/`subjectId`/`classId`/`sectionId`/`periodIndex` are
/// resolved from `SubstitutionForm`'s chosen `TimetableEntry` at submit time and sent flattened
/// (`frontend/src/features/timetable/schemas.ts`'s own comment on `substitutionSchema`), not
/// stored here as a pointer back to it.
model Substitution {
  id                  String   @id @default(uuid())
  tenantId            String
  date                DateTime @db.Date
  classId             String
  sectionId           String
  periodIndex         Int
  subjectId           String
  originalTeacherId   String
  substituteTeacherId String
  reason              String   @default("")
  createdAt           DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([date])
  @@map("substitutions")
}

// §13's own six statuses — matches `ATTENDANCE_STATUSES` in `attendance/schemas.ts` verbatim.
enum AttendanceStatus {
  present
  absent
  late
  excused
  half_day
  leave
}

/// §13 Student Attendance — one row per student per day. `@@unique([studentId, date])` has no
/// `tenantId` in the compound key, same reasoning as `ParentStudentLink`'s own
/// `@@unique([parentId, studentId])`: `studentId` is already a globally-unique uuid, so no two
/// tenants can ever collide on this pair — keeping `tenantId` out of the compound key avoids
/// PrismaService's tenant-scoping extension needing to know about a tenant-inclusive compound
/// selector. This is also exactly the upsert key `POST /attendance/bulk` needs: marking an
/// already-marked day again corrects it in place, matching `attendance.md`'s "pre-fills the
/// marking UI if already partially marked". `markedByUserId`/`markedByLabel` are a denormalized
/// actor snapshot, same pattern as `DocumentVersion.uploadedByUserId`/`.uploadedByLabel`.
model AttendanceRecord {
  id             String           @id @default(uuid())
  tenantId       String
  studentId      String
  classId        String
  sectionId      String
  date           DateTime         @db.Date
  status         AttendanceStatus
  markedByUserId String?
  markedByLabel  String           @default("")
  markedAt       DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([tenantId])
  @@index([classId, sectionId, date])
  @@map("attendance_records")
}

enum LeaveStatus {
  pending
  approved
  rejected
}

/// §14 Student Leave — Parent submits → Teacher/Admin review (this module owns the review queue
/// and the record itself; the parent-side submission form renders inside the portal shell, per
/// `attendance.md`'s own "Requirements" section). `startDate`/`endDate` back the frontend's
/// `dateRange: { from, to }` — the API response composes the two into that shape, same "form shape
/// != wire shape" pattern `Enrollment`/`Substitution` above already use.
model LeaveRequest {
  id                String      @id @default(uuid())
  tenantId          String
  studentId         String
  startDate         DateTime    @db.Date
  endDate           DateTime    @db.Date
  reason            String
  status            LeaveStatus @default(pending)
  submittedByUserId String?
  submittedByLabel  String      @default("")
  reviewedByUserId  String?
  reviewedByLabel   String?
  reviewNotes       String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([studentId])
  @@index([status])
  @@map("leave_requests")
}

/// §15 Homework & Assignment Management. `attachments` is `HomeworkAttachment[]` JSON, same
/// trade-off as `Student.emergencyContacts` — never queried individually — and stays an
/// always-empty placeholder for now: `homeworkSchema` (the frontend's own create/edit payload) has
/// no attachments field yet, matching `homework.md`'s own "Open questions" note that file upload
/// isn't wired here even though the shared `documents/` primitive exists. `teacherId` is stamped
/// server-side from the authenticated session at create time, never client-supplied.
model Homework {
  id          String   @id @default(uuid())
  tenantId    String
  title       String
  description String   @default("")
  attachments Json     @default("[]")
  links       String[] @default([])
  deadline    DateTime
  classIds    String[]
  sectionIds  String[]
  teacherId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  submissions HomeworkSubmission[]

  @@index([tenantId])
  @@map("homework")
}

enum SubmissionStatus {
  submitted
  graded
}

/// One row per student per homework, created only on actual submit — "not submitted" is the
/// absence of a row for that `(homeworkId, studentId)` pair, resolved at read time
/// (`homework.service.ts`), not a stored status. `files` is JSON, same placeholder-until-wired
/// reasoning as `Homework.attachments` above (`submissionSchema` has no file field yet either).
model HomeworkSubmission {
  id             String           @id @default(uuid())
  tenantId       String
  homeworkId     String
  studentId      String
  files          Json             @default("[]")
  textResponse   String           @default("")
  submittedAt    DateTime         @default(now())
  status         SubmissionStatus @default(submitted)
  grade          String?
  feedback       String?
  gradedAt       DateTime?
  gradedByUserId String?
  gradedByLabel  String?

  homework Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([homeworkId, studentId])
  @@index([tenantId])
  @@index([homeworkId])
  @@index([studentId])
  @@map("homework_submissions")
}

// ---------------------------------------------------------------------------
// Examinations (PRD §16, Phase 5) — `frontend/modules/examinations.md` "Backend dependencies" is
// the source contract. Two corrections against the real frontend source, same discipline as every
// earlier phase's own correction notes:
//
// 1. No separate `Mark`/`Result`/`Grade`/`ReportCard` entities (`../implementation-plan.md`'s
//    original Phase 5 entity list had all four) — `features/examinations/api.ts`'s `ExamResultRow`/
//    `ReportCard` shapes are entirely server-computed from one `ExamMark` row per (exam, student)
//    plus the fixed grading scale below, never stored; same "no separate aggregate entity"
//    correction as Phase 3's `AdmissionInquiry` / Phase 4's `Timetable` header entity.
// 2. `Exam` is single-subject (`examSchema`'s `subjectId` is one field, not a list) — a report
//    card's multi-subject view is **not** one `Exam` row, it's every `Exam` sharing the same
//    `(type, classId, sectionId)` treated as one series (e.g. every "Midterm" exam for class 5-A
//    across subjects). `examinations.service.ts`'s `getReportCard` resolves this explicitly; there
//    is no separate `ExamSeries`/`ExamGroup` entity, the grouping key is computed at read time.
// ---------------------------------------------------------------------------

// PRD §16 "Exam Types" — matches `EXAM_TYPES` in `frontend/src/features/examinations/schemas.ts`
// verbatim, same lowercase-member-name convention as `SubjectType`/`AttendanceStatus`.
enum ExamType {
  quiz
  monthly
  midterm
  final
  practical
  oral
  entrance
  assignment
}

/// One row per subject per exam sitting. `room`/`invigilatorId` are free text, same
/// `Section.roomLabel`/`TimetableEntry.roomId` no-Room-entity trade-off — `invigilatorId` is
/// actually a `Teacher` id string, not validated by a DB foreign key (soft-validated at the
/// application layer when non-empty, matching `classIds`/`subjectIds`'s existing trade-off), and
/// stays empty for exam types that genuinely don't need one (`examSchema`'s own comment: "not
/// every exam type needs one"). `isPublished` isn't part of the frontend's own `Exam` type
/// (`api.ts extends ExamFormValues { id }` — no publish flag on the exam itself) — it's this
/// schema's own field backing `ExamResults.isPublished`, deliberately not echoed on the plain
/// `Exam` response so as not to invent a field the frontend doesn't expect there.
model Exam {
  id            String   @id @default(uuid())
  tenantId      String
  type          ExamType
  subjectId     String
  classId       String
  sectionId     String
  date          DateTime @db.Date
  startTime     String   @default("")
  endTime       String   @default("")
  room          String   @default("")
  invigilatorId String   @default("")
  maxMarks      Float
  /// Set by `POST /exams/:id/publish` (`results.publish`). Locks further `POST /exams/:id/marks`
  /// edits — see `ExamMarksService`'s own doc comment — unless the caller holds `results.publish`
  /// themselves, which doubles as the "re-opened by an authorized role" override
  /// `examinations.md`'s "Marks entry" section names, since no separate unlock endpoint exists on
  /// the frontend's built contract.
  isPublished   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  marks  ExamMark[]

  @@index([tenantId])
  @@index([classId, sectionId])
  @@index([subjectId])
  @@index([type, classId, sectionId])
  @@map("exams")
}

/// One row per student per exam — the only stored fact; grade/percentage/GPA/rank are all
/// computed at read time (see this section's header comment). No explicit `tenant Tenant
/// @relation` here, same trade-off `AttendanceRecord`/`HomeworkSubmission` already make: this is
/// the high-volume leaf table, `tenantId` stays a plain scoped column and `examId`/`studentId`
/// carry the real relations. `@@unique([examId, studentId])` (no `tenantId` in the compound key,
/// same reasoning as `AttendanceRecord`'s `[studentId, date]`) is also the bulk-upsert key `POST
/// /exams/:id/marks` needs — resubmitting the grid corrects it in place.
model ExamMark {
  id            String   @id @default(uuid())
  tenantId      String
  examId        String
  studentId     String
  /// `null` when not yet entered *or* when absent — `isAbsent` is the field that disambiguates
  /// the two, same "0 marks" vs. "didn't sit the exam" split `marksEntryRecordSchema`'s own
  /// `.refine()` enforces on the frontend (re-enforced server-side, not just trusted).
  marksObtained Float?
  isAbsent      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId])
  @@index([tenantId])
  @@index([studentId])
  @@map("exam_marks")
}

// ---------------------------------------------------------------------------
// Fees & Finance (PRD §18, Phase 6 — closes the PRD §65 MVP) —
// `frontend/modules/fees.md` "Backend dependencies"/"Data model" is the source contract.
// Accounting (§19: chart of accounts, expenses, vendors) is **not** built here — `fees.md`'s own
// "Open questions" resolves it as "confirmed Phase 7+, don't let it creep into this phase's
// scope", and the module doc's endpoint list has no accounting routes at all; the earlier
// aspirational `accounting/` line in `../implementation-plan.md`'s Phase 6 "Modules" list predates
// that resolution and is corrected in this phase's own section there.
// ---------------------------------------------------------------------------

/// §18 Fee Types — `frontend/src/features/fees/schemas.ts`'s `FEE_TYPES`, same lowercase-enum-
/// member-matches-frontend-string convention as `SubjectType`.
enum FeeType {
  admission
  tuition
  transport
  library
  lab
  exam
  sports
  uniform
  other
}

/// §18 Payment Methods — `schemas.ts`'s `PAYMENT_METHODS`.
enum PaymentMethod {
  cash
  bank_transfer
  card
  online_gateway
  mobile_wallet
}

enum InvoiceStatus {
  pending
  partial
  paid
  overdue
  cancelled
}

/// §18 Fee structure config (admin-defined). `discountRules` is `DiscountRule[]` JSON
/// (`{ label, kind: 'flat'|'percentage', value }`), same never-queried-individually trade-off as
/// `Student.emergencyContacts` — always read/written as one whole list per `FeeStructureForm`'s
/// `useFieldArray` shape, never its own sub-resource. Installment plans and late-fee rules are
/// explicitly out of MVP scope (`fees.md`'s own "Open questions") — no columns for either; adding
/// them later is additive, not a rework, the same bet `AcademicYear.terms`/`.holidays` already
/// made.
model FeeStructure {
  id                String   @id @default(uuid())
  tenantId          String
  name              String
  type              FeeType
  amount            Float
  applicableClasses String[]
  discountRules     Json     @default("[]")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices Invoice[]
  routes   Route[]

  @@index([tenantId])
  @@map("fee_structures")
}

/// §18 Invoices. `studentId`/`admissionApplicationId` are both nullable — a pre-enrollment
/// admission-fee invoice has no `Student` row yet (`../implementation-plan.md`'s resolved Phase 3
/// admissions↔fees ordering decision: Fee Payment runs before Enrollment) — so **at least one of
/// the two must be set, never neither**, enforced by a DB `CHECK` constraint added by hand in this
/// phase's migration SQL (Prisma has no declarative check-constraint syntax as of this schema's
/// Prisma version, same reason `tenant-scoping.ts`'s five-operation split is hand-documented code
/// rather than schema-expressed). Deliberately not an exclusive-or: `AdmissionsService.enroll`
/// reconciles a paid admission invoice once the `Student` is actually created by backfilling
/// `studentId` onto every `Invoice` carrying that `admissionApplicationId` *without* clearing
/// `admissionApplicationId` (kept as the historical link) — so a reconciled row legitimately has
/// both set. Every other invoice naturally has exactly one, never both — this constraint just
/// doesn't force that as a rule.
///
/// `lineItems` is `InvoiceLineItem[]` JSON (`{ label, amount }`), same trade-off as
/// `FeeStructure.discountRules` — display-only, never the authoritative number. `totalAmount` is
/// computed server-side once at generation time from the fee structure + its discount rules
/// (`fee-calc.ts`, mirroring `frontend/src/features/fees/lib/invoiceCalc.ts`'s own math so the two
/// sides agree); `paidAmount`/`status` are recomputed from real `Payment` rows every time one is
/// recorded or refunded — never trusted from the client, matching every other server-computed
/// field in this schema (`Exam`'s grade/GPA/rank, `AdmissionApplication`'s stage machine).
///
/// **A real, flagged limit, not a bug:** `status` is persisted at write time
/// (pending/partial/paid) and only re-checked against `dueDate` for the `overdue` transition on
/// read (`InvoicesService`'s own doc comment) — there is no scheduled sweep job flipping stale
/// invoices to `overdue` in the database itself (BullMQ scheduled jobs are Phase 7+ scope per
/// `../implementation-plan.md`'s tech-stack table). `GET /fees/invoices?status=overdue` therefore
/// filters on the last-computed stored value, which can lag a display-time recompute by up to one
/// page load — acceptable for MVP, worth a real scheduled job once background workers exist.
model Invoice {
  id                     String        @id @default(uuid())
  tenantId               String
  studentId              String?
  admissionApplicationId String?
  feeStructureId         String
  lineItems              Json          @default("[]")
  dueDate                DateTime      @db.Date
  status                 InvoiceStatus @default(pending)
  totalAmount            Float
  paidAmount             Float         @default(0)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student              Student?              @relation(fields: [studentId], references: [id], onDelete: SetNull)
  admissionApplication AdmissionApplication? @relation(fields: [admissionApplicationId], references: [id], onDelete: SetNull)
  feeStructure         FeeStructure          @relation(fields: [feeStructureId], references: [id])
  payments             Payment[]

  @@index([tenantId])
  @@index([studentId])
  @@index([admissionApplicationId])
  @@index([status])
  @@map("invoices")
}

/// §18 Payments. No explicit `tenant Tenant @relation` here, same high-volume-leaf trade-off
/// `AttendanceRecord`/`ExamMark` already make (`invoiceId` carries the real relation, `tenantId`
/// stays a plain scoped column still enforced by `PrismaService`'s tenant-scoping extension via
/// `TENANT_SCOPED_MODELS`, which only needs the column, not a Prisma relation object). `refunded`
/// is all-or-nothing — `fees.md`'s own "Open questions": "Refunds are all-or-nothing... no
/// partial-refund amount field" — refunding reverses this payment's full `amount` off the
/// invoice's `paidAmount`, never a partial sum; add a `refundedAmount` column instead of mutating
/// this shape if partial refunds are ever scoped.
model Payment {
  id            String        @id @default(uuid())
  tenantId      String
  invoiceId     String
  amount        Float
  method        PaymentMethod
  referenceId   String        @default("")
  receiptNumber String
  paidAt        DateTime      @default(now())
  refunded      Boolean       @default(false)
  refundedAt    DateTime?
  createdAt     DateTime      @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([tenantId, receiptNumber])
  @@index([tenantId])
  @@index([invoiceId])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Library (PRD §22, Phase 7.2) — `frontend/modules/library.md` "Backend dependencies" is the
// source contract. Two simplifications from PRD §22's entity list, carried over from the
// frontend's own (already-shipped) simplifications rather than re-litigated here: authors/
// publishers are free-text fields on `Book`, not their own normalized entities, and there is no
// separate `Fine` entity — a fine is just `Loan.fineAmount`/`.fineStatus`, and
// `GET /library/fines` is `GET /library/loans` filtered to `fineStatus != none` (same
// "entity list corrected against what the frontend actually built" pattern as Phase 3's dropped
// `AdmissionInquiry` and Phase 4's collapsed `TimetableEntry`).
// ---------------------------------------------------------------------------

/// Lightweight reference lists (`library.md`'s "Categories and shelves ... add/delete only, no
/// other fields"). `Book.categoryId`/`.shelfId` are plain string columns, not FK relations, same
/// "peer entity, no ownership hierarchy" trade-off as `TimetableEntry.subjectId` — validated at
/// the application layer, not the database, so deleting a category never cascades into books.
model LibraryCategory {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("library_categories")
}

model LibraryShelf {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("library_shelves")
}

/// §22 Catalog. `totalCopies`/`availableCopies` on `frontend/src/features/library/api.ts`'s `Book`
/// are computed from the `copies` relation at read time (`LibraryCatalogService.toBookResponse`),
/// never stored columns — same "server-computed, never trusted from the client" discipline as
/// every other derived count in this schema (`Invoice.status`, `Exam`'s rank/GPA).
model Book {
  id          String   @id @default(uuid())
  tenantId    String
  title       String
  isbn        String   @default("")
  author      String
  publisher   String   @default("")
  categoryId  String   @default("")
  shelfId     String   @default("")
  edition     String   @default("")
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  copies       BookCopy[]
  reservations Reservation[]

  @@index([tenantId])
  @@map("library_books")
}

enum CopyStatus {
  available
  issued
  lost
  damaged
}

/// One row per physical copy, looked up by `barcode` at the circulation desk
/// (`GET /library/copies/lookup?barcode=`) — resolved as keyboard-wedge scanner input per
/// `library.md`'s own open question, so `barcode` is just a plain unique string, no camera/device
/// plumbing. No direct `tenant Tenant` relation — same high-volume-leaf trade-off as
/// `Payment`/`AttendanceRecord` (cascades transitively via `book`), `tenantId` stays a plain
/// scoped column enforced by `PrismaService`'s tenant-scoping extension.
model BookCopy {
  id        String     @id @default(uuid())
  tenantId  String
  bookId    String
  barcode   String
  status    CopyStatus @default(available)
  createdAt DateTime   @default(now())

  book  Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  loans Loan[]

  @@unique([tenantId, barcode])
  @@index([tenantId])
  @@index([bookId])
  @@map("library_book_copies")
}

enum LibraryMemberType {
  student
  teacher
}

enum LibraryMemberStatus {
  active
  suspended
}

/// §22 Members — `library.md`'s "link to students/staff, don't duplicate person records": a
/// `{ memberType, personId }` reference plus lending limits, not a new person record. `personId`
/// is a plain string (no FK to `Student`/`Teacher`, whichever `memberType` says), same "peer
/// entity" trade-off as `Book.categoryId` — validated in `LibraryMembersService` against the real
/// table before create. `personLabel` is a client-supplied denormalized snapshot
/// (`MemberForm`'s own search-and-pick result), same discipline as `DocumentVersion.
/// uploadedByLabel` — never re-derived from `Student`/`Teacher` on every read.
model LibraryMember {
  id             String              @id @default(uuid())
  tenantId       String
  memberType     LibraryMemberType
  personId       String
  personLabel    String
  maxBooks       Int                 @default(3)
  loanPeriodDays Int                 @default(14)
  status         LibraryMemberStatus @default(active)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  loans        Loan[]
  reservations Reservation[]

  @@unique([tenantId, memberType, personId])
  @@index([tenantId])
  @@map("library_members")
}

enum FineStatus {
  none
  pending
  paid
  waived
}

/// `library.md`'s "resolved: reserve on a member's behalf" return conditions
/// (`schemas.ts`'s `RETURN_CONDITIONS`) — recorded on the loan for its own sake (an audit trail of
/// how a copy actually came back) even though the frontend's `Loan` response type doesn't surface
/// it back; `condition !== 'ok'` is what drives the copy's post-return `status`.
enum ReturnCondition {
  ok
  lost
  damaged
}

/// §22 Circulation — one row per issue/return cycle. No separate `Fine` entity (see this section's
/// header comment): `fineAmount`/`fineStatus` live here, computed server-side at return time
/// (`LibraryCirculationService.returnBook`, mirroring `frontend/src/features/library/lib/
/// fines.ts`'s `calculateFine` so the two sides agree) — never trusted from the client. No direct
/// `tenant Tenant` relation, same leaf trade-off as `BookCopy` above (cascades via `copy`/
/// `member`).
model Loan {
  id              String           @id @default(uuid())
  tenantId        String
  copyId          String
  memberId        String
  issuedAt        DateTime         @default(now()) @db.Date
  dueAt           DateTime         @db.Date
  returnedAt      DateTime?        @db.Date
  returnCondition ReturnCondition?
  fineAmount      Float            @default(0)
  fineStatus      FineStatus       @default(none)
  createdAt       DateTime         @default(now())

  copy   BookCopy      @relation(fields: [copyId], references: [id], onDelete: Cascade)
  member LibraryMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([copyId])
  @@index([memberId])
  @@map("library_loans")
}

enum ReservationStatus {
  pending
  fulfilled
  cancelled
}

/// §22 Reservations (`library.md`'s "Not built" section, now resolved) — a FIFO queue per book.
/// `queuePosition` (`frontend/src/features/library/api.ts`'s `Reservation.queuePosition`) is
/// computed at read time as this row's 1-indexed rank among `pending` reservations for the same
/// `bookId` ordered by `reservedAt`, never a stored column — same "server-computed" discipline as
/// `Book.totalCopies`. `memberLabel` is always resolved from the linked `LibraryMember.
/// personLabel`, never client-supplied — unlike `Loan`, `createReservation`'s payload
/// (`api.ts`) never sends a label. No direct `tenant Tenant` relation, same leaf trade-off as
/// `Loan` (cascades via `book`/`member`).
model Reservation {
  id         String            @id @default(uuid())
  tenantId   String
  bookId     String
  memberId   String
  reservedAt DateTime          @default(now()) @db.Date
  status     ReservationStatus @default(pending)
  createdAt  DateTime          @default(now())

  book   Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  member LibraryMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([bookId])
  @@index([memberId])
  @@map("library_reservations")
}

/// `library.md`'s "Open questions: Fine rate", now resolved — a single per-tenant settings
/// document (`GET/PATCH /library/settings`), same one-row-per-tenant shape as `School`.
model LibrarySettings {
  tenantId       String   @id
  finePerDayRate Float    @default(0)
  maxFine        Float?
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("library_settings")
}

// ---------------------------------------------------------------------------
// Transport (PRD §23, Phase 7.3) — vehicle/route management only; live tracking (§23 Live
// Tracking: GPS WebSocket channel, geofencing, pickup/drop-off confirmation) is its own
// not-yet-scheduled sub-phase, see `../implementation-plan.md`'s Phase 7.3 section.
// ---------------------------------------------------------------------------

enum VehicleType {
  bus
  van
  car
  other
}

enum VehicleStatus {
  active
  maintenance
  inactive
}

/// §23 Vehicles. `driverName`/`driverPhone` are free text — no Staff/HR module yet
/// (`hr-payroll.md` is backlog), same placeholder pattern `Section.classTeacherName` already set.
model Vehicle {
  id                  String        @id @default(uuid())
  tenantId            String
  registrationNumber  String
  type                VehicleType
  capacity            Int
  status              VehicleStatus @default(active)
  driverName          String        @default("")
  driverPhone         String        @default("")
  insuranceProvider   String        @default("")
  /// Nullable rather than a plain free-text string (unlike `driverName`/`driverPhone` above) —
  /// `transport.md` lists insurance expiry as a tracked field a future "expiring soon" report
  /// would query/sort by, so it's worth keeping as a real date from day one even though nothing
  /// reads it that way yet. `''` from the frontend's `<input type="date">` round-trips to `null`,
  /// same as `Loan.returnedAt`'s own nullable-date shape.
  insuranceExpiryDate DateTime?     @db.Date
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  tenant             Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  maintenanceRecords VehicleMaintenanceRecord[]
  routes             Route[]

  @@unique([tenantId, registrationNumber])
  @@index([tenantId])
  @@map("vehicles")
}

/// Repeatable date/description/cost list nested under a Vehicle — replaced wholesale on every
/// vehicle write, same `Building`/`Department` "still a real child table underneath an
/// array-in-payload contract" convention (`Branch`'s own doc comment). Ordered by `date desc` at
/// read time (most recent first), not by a stored sequence — there's no user-meaningful ordering
/// beyond chronological, unlike `RouteStop.order` below.
model VehicleMaintenanceRecord {
  id          String   @id @default(uuid())
  tenantId    String
  vehicleId   String
  date        DateTime @db.Date
  description String
  cost        Float?
  createdAt   DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([vehicleId])
  @@map("vehicle_maintenance_records")
}

/// §23 Routes. `studentIds` is a plain string array, same trade-off as `Teacher.subjectIds`/
/// `Subject.classIds` (referential integrity enforced in `routes.service.ts`, not a DB foreign
/// key) — `../implementation-plan.md`'s Phase 7.3 entity list originally drafted a separate
/// `TransportAssignment` join entity; the actually-built frontend (`schemas.ts`'s `routeSchema`,
/// `RouteForm.tsx`'s search-and-pick student list) sends and reads back one flat `studentIds[]`
/// on the route itself, never a separate assignment resource, same "no separate aggregate entity"
/// correction every earlier phase's own status note already made at least once.
/// `feeStructureId` is nullable — `RouteForm.tsx` sends `''` for "no linkage", normalized to
/// `null` in `routes.service.ts` (`fees.md`'s fee-linkage is optional per the module doc's own
/// contract note).
model Route {
  id             String   @id @default(uuid())
  tenantId       String
  name           String
  vehicleId      String
  driverName     String   @default("")
  attendantName  String   @default("")
  feeStructureId String?
  studentIds     String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle      Vehicle       @relation(fields: [vehicleId], references: [id])
  feeStructure FeeStructure? @relation(fields: [feeStructureId], references: [id], onDelete: SetNull)
  stops        RouteStop[]

  @@index([tenantId])
  @@index([vehicleId])
  @@index([feeStructureId])
  @@map("routes")
}

/// Repeatable name/time list nested under a Route — replaced wholesale on every route write, same
/// `Building`/`Department` convention as `VehicleMaintenanceRecord` above. Unlike maintenance
/// records, stop order is operationally meaningful (the sequence a vehicle actually visits them
/// in), so it's a stored `order` column set from the submitted array's index at write time, not
/// re-derived from `name`/`time` at read time.
model RouteStop {
  id       String @id @default(uuid())
  tenantId String
  routeId  String
  name     String
  time     String @default("")
  order    Int    @default(0)

  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([routeId])
  @@map("route_stops")
}

// ---------------------------------------------------------------------------
// Inventory & Assets (PRD §24, Phase 7.4) — `frontend/modules/inventory.md` "Backend
// dependencies" is the source contract. Two distinct models, same split the module doc itself
// draws: consumable **stock** (a category reference list + a running quantity, adjusted only
// through a logged `StockMovement` — `quantity` is never client-writable past creation, see
// `StockItemsService.update`'s own doc comment) and fixed **assets** (a full lifecycle record;
// depreciation is resolved client-side, straight-line, `lib/depreciation.ts` — nothing computed
// or stored here, per that module doc's own resolved "Open questions" note).
// ---------------------------------------------------------------------------

/// Lightweight reference list (`inventory.md`'s "categories ... stationery, uniforms, books, lab
/// equipment, sports equipment, consumables"), same add/delete-only shape as `LibraryCategory`.
/// `StockItem.categoryId` is a plain string column, not an FK relation — same "peer entity, no
/// ownership hierarchy" trade-off as `Book.categoryId`/`.shelfId`, validated at the application
/// layer (`StockItemsService.assertCategoryExists`), not the database.
model StockCategory {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("stock_categories")
}

/// §24 Inventory. `quantity` starts from the create payload but is otherwise read-only through
/// this model's own CRUD — `StockForm.tsx` disables the field once an item exists, and this
/// service enforces that server-side too (an update's `quantity` is ignored, the stored value is
/// kept), so `StockMovement` stays the one authoritative log of every change.
model StockItem {
  id                String   @id @default(uuid())
  tenantId          String
  name              String
  categoryId        String
  unit              String
  quantity          Int      @default(0)
  lowStockThreshold Int      @default(0)
  unitCost          Float?
  notes             String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  movements StockMovement[]

  @@index([tenantId])
  @@index([categoryId])
  @@map("stock_items")
}

enum StockMovementType {
  restock
  issue
  adjustment
}

/// `inventory.md`'s "issue/adjustment log" (`StockAdjustmentDialog`) — one append-only row per
/// issue/restock/adjustment. `quantityChange` is a signed delta the frontend itself computes
/// (positive for a restock, negative otherwise, per that component's own doc comment) and
/// `StockItemsService.recordMovement` simply applies it to `StockItem.quantity` — never re-derives
/// the sign from `type` server-side, and rejects a movement that would take quantity negative. No
/// direct `tenant Tenant` relation, same high-volume-leaf trade-off as `Loan`/`Payment`/
/// `VehicleMaintenanceRecord` — created via a top-level call, so `PrismaService`'s tenant-scoping
/// extension still stamps `tenantId` on it without needing a declared relation.
model StockMovement {
  id             String            @id @default(uuid())
  tenantId       String
  stockItemId    String
  type           StockMovementType
  quantityChange Int
  issuedTo       String            @default("")
  reason         String            @default("")
  date           DateTime          @db.Date
  createdAt      DateTime          @default(now())

  stockItem StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([stockItemId])
  @@map("stock_movements")
}

enum AssetCategory {
  computer
  furniture
  vehicle
  equipment
  other
}

/// §24 Assets — full lifecycle record (asset ID, purchase date/cost, location, assigned person,
/// warranty, maintenance, disposal). `location`/`assignedTo` are free text, same placeholder
/// pattern `Section.classTeacherName`/`Vehicle.driverName` already set — no Staff/HR module yet to
/// pick a real person from. `warrantyExpiryDate`/`disposalDate` are nullable dates, not plain
/// strings, same "worth keeping as a real date from day one" reasoning as `Vehicle.
/// insuranceExpiryDate` — `''` from the frontend's `<input type="date">` round-trips to `null`.
/// `status` is a plain `String`, not a Prisma enum like `category` above — the frontend's own
/// literals (`schemas.ts`'s `ASSET_STATUSES`) are hyphenated ("in-use", "in-storage",
/// "under-maintenance", "disposed"), and a Prisma enum's *member names* can't contain a hyphen.
/// `@map` on an enum value only renames its database representation, not the string the generated
/// client actually reads/writes in TypeScript — using it here would silently reintroduce exactly
/// the translation layer this schema's "match the frontend string exactly" discipline exists to
/// avoid (caught before this shipped, see git history). Validated at the application layer
/// instead (`ASSET_STATUSES`/`@IsIn` in `assets/dto/asset.dto.ts`), same "peer entity, no DB-level
/// constraint" trade-off `Book.categoryId`/`.shelfId` already make for a client-owned string set.
model Asset {
  id                 String        @id @default(uuid())
  tenantId           String
  assetCode          String
  name               String
  category           AssetCategory
  status             String        @default("in-use")
  purchaseDate       DateTime      @db.Date
  purchaseCost       Float
  usefulLifeYears    Int
  location           String        @default("")
  assignedTo         String        @default("")
  warrantyExpiryDate DateTime?     @db.Date
  disposalDate       DateTime?     @db.Date
  disposalReason     String        @default("")
  disposalValue      Float?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  tenant             Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  maintenanceRecords AssetMaintenanceRecord[]

  @@unique([tenantId, assetCode])
  @@index([tenantId])
  @@map("assets")
}

/// Repeatable date/description/cost list nested under an Asset — replaced wholesale on every
/// asset write (delete-then-recreate in the same transaction), same `VehicleMaintenanceRecord`
/// convention (ordered by `date desc` at read time, no direct `tenant Tenant` relation — a
/// nested-only leaf, manually stamped with `tenantId` by `AssetsService` since the tenant-scoping
/// extension can't see into a nested `data.maintenanceRecords: { create: [...] }` write).
model AssetMaintenanceRecord {
  id          String   @id @default(uuid())
  tenantId    String
  assetId     String
  date        DateTime @db.Date
  description String
  cost        Float?
  createdAt   DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([assetId])
  @@map("asset_maintenance_records")
}

// ---------------------------------------------------------------------------
// Hostel (PRD §25, Phase 7.5) — `frontend/modules/hostel.md` "Backend dependencies" is the
// source contract. The PRD's `hostel → building → floor → room → bed` hierarchy is collapsed to
// `hostel → room → bed`, matching the frontend's own already-shipped simplification: a school
// with several physical hostel buildings just registers each as its own `Hostel`, `floor` survives
// as a free-text `Room.floorLabel`, and beds are never their own entity — a room's `capacity` is
// its bed count, occupancy derived from active `Allocation`s (bed numbers `1..capacity`), matching
// `lib/occupancy.ts`'s frontend logic exactly so the two never disagree about which beds are free.
// Hostel fee linkage stays unresolved on both sides (`hostel.md`'s own open question, no frontend
// wiring exists for it) — not built here either.
// ---------------------------------------------------------------------------

enum HostelType {
  boys
  girls
  mixed
}

/// §25. `wardenName` is free text, same placeholder pattern `Section.classTeacherName`/`Vehicle.
/// driverName` already set — no Staff/HR module yet to pick a real person from.
model Hostel {
  id         String     @id @default(uuid())
  tenantId   String
  name       String
  type       HostelType
  address    String     @default("")
  wardenName String     @default("")
  notes      String     @default("")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rooms      Room[]
  complaints Complaint[]

  @@index([tenantId])
  @@map("hostels")
}

enum RoomType {
  dormitory
  shared
  private
}

/// §25 Rooms. `occupiedBeds` (`frontend/src/features/hostel/api.ts`'s `Room.occupiedBeds`) is
/// server-computed from active `Allocation` rows at read time, same "server owns the count" idiom
/// as `library`'s `Book.availableCopies` — never a stored column.
model Room {
  id         String   @id @default(uuid())
  tenantId   String
  hostelId   String
  floorLabel String   @default("")
  roomNumber String
  capacity   Int
  roomType   RoomType
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hostel      Hostel       @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  allocations Allocation[]

  @@unique([tenantId, hostelId, roomNumber])
  @@index([tenantId])
  @@index([hostelId])
  @@map("hostel_rooms")
}

enum AllocationStatus {
  active
  vacated
}

/// §25 Room allocation — one row per stay, not overwritten on reassignment (`reassignAllocation`
/// updates `roomId`/`bedNumber` in place on the *same* row, so a resident keeps one allocation
/// history entry per continuous stay; `vacateAllocation` closes it out rather than deleting it, so
/// `ResidentsTable`'s history and any later occupancy audit stay intact). `studentLabel` is never
/// client-supplied (`api.ts`'s `createAllocation` payload deliberately carries only `{ studentId,
/// roomId, bedNumber }`, dropping `AllocationFormValues.studentLabel` before the request even goes
/// out) — always resolved live from the real `Student` row, same discipline `VehiclesService`/
/// `RoutesService` already apply to every other real-entity reference in this schema.
/// `allocatedAt`/`vacatedAt` are date-only (`@db.Date`), not full timestamps — matches this
/// schema's own `Loan.issuedAt`/`.returnedAt` precedent for a "since when" resident-facing date
/// where day granularity is what actually gets displayed (`ResidentsTable`'s "Since" column).
model Allocation {
  id          String           @id @default(uuid())
  tenantId    String
  studentId   String
  roomId      String
  bedNumber   Int
  allocatedAt DateTime         @default(now()) @db.Date
  vacatedAt   DateTime?        @db.Date
  status      AllocationStatus @default(active)
  createdAt   DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([roomId])
  @@index([studentId])
  @@map("hostel_allocations")
}

/// §25 Visitor log. Unlike `Allocation.studentLabel` above, `residentLabel` genuinely is
/// client-supplied here — `api.ts`'s `checkInVisitor` posts the whole `VisitorFormValues` payload
/// unmodified, `residentLabel` included (`VisitorForm`'s own search-and-pick result) — same
/// denormalized-snapshot trade-off `LibraryMember.personLabel` already makes, not re-derived from
/// `Student` on every read. `residentStudentId` is still validated against a real `Student` row at
/// write time (`HostelVisitorsService.assertStudentExists`), just not used to override the label.
/// `checkInAt`/`checkOutAt` are full timestamps, not date-only — a visitor log records the actual
/// time on the premises, not just the day (unlike `Allocation`'s day-granularity dates above). No
/// direct `tenant Tenant` relation, same high-volume-leaf trade-off as `Loan`/`VehicleMaintenanceRecord`
/// — created via a top-level call, so the tenant-scoping extension still stamps `tenantId` on it.
model Visitor {
  id                String    @id @default(uuid())
  tenantId          String
  residentStudentId String
  residentLabel     String
  visitorName       String
  relation          String
  purpose           String    @default("")
  checkInAt         DateTime  @default(now())
  checkOutAt        DateTime?

  @@index([tenantId])
  @@index([residentStudentId])
  @@map("hostel_visitors")
}

enum ComplaintCategory {
  maintenance
  food
  discipline
  other
}

/// §25 Complaints. `status` is a plain `String`, not a Prisma enum — same reasoning as `Asset.
/// status` above: the frontend's own literals (`schemas.ts`'s `COMPLAINT_STATUSES`) include
/// `"in-progress"`, hyphenated, which a Prisma enum member name can't hold and `@map` would only
/// mistranslate (see `Asset.status`'s doc comment for the fuller "caught before it shipped"
/// story). Validated at the application layer instead (`COMPLAINT_STATUSES`/`@IsIn` in
/// `dto/complaint.dto.ts`). `roomId`/`residentStudentId` are both nullable — a complaint about the
/// mess hall, say, has neither (`complaintSchema`'s own comment); `residentLabel` is likewise
/// client-supplied when present, same trade-off `Visitor.residentLabel` makes and for the same
/// reason (`api.ts`'s `createComplaint` forwards `ComplaintFormValues` — including
/// `residentLabel` — as-is). `hostelName`/`roomLabel` on the response, by contrast, are always
/// resolved live server-side from the real `Hostel`/`Room` rows, never stored.
model Complaint {
  id                String            @id @default(uuid())
  tenantId          String
  hostelId          String
  roomId            String?
  residentStudentId String?
  residentLabel     String?
  category          ComplaintCategory
  description       String
  status            String            @default("open")
  resolutionNotes   String?
  createdAt         DateTime          @default(now())
  resolvedAt        DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hostel Hostel @relation(fields: [hostelId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([hostelId])
  @@map("hostel_complaints")
}

// ---------------------------------------------------------------------------
// HR & Payroll (PRD §20/§21/§14 Employee Leave, Phase 7.6) — two model groups mirroring
// `frontend/modules/hr-payroll.md`'s own two-folder split (`hr/`, `payroll/`): employee lifecycle
// + leave here, salary/period/payslip below. Department/designation stay free text and leave
// types stay a fixed four-value enum, same simplification call `hostel.md`'s room hierarchy and
// `transport.md`'s driver-as-free-text already made (module doc "Simplifications made to fit this
// doc's own scope").
// ---------------------------------------------------------------------------

enum EmploymentType {
  full_time
  part_time
  contract
}

enum EmployeeStatus {
  active
  on_leave
  resigned
  terminated
}

/// §21 HR Management. `employeeId` is the org's own human-readable staff code (`employeeSchema`'s
/// required field, e.g. "EMP-001") — unrelated to this row's own `id` primary key, unique per
/// tenant same as `Teacher.employeeId`. `status` only ever moves through the three lifecycle
/// actions below (`EmployeesService`'s own doc comment) — never a plain field edit, matching
/// `AdmissionApplication.stage`'s "no direct write" precedent. `userId` is the `employeeId=me`
/// self-service portal-login link, same documented-gap idiom as `Teacher.userId`/`Student.userId`
/// (`common/identity/resolve-me.ts`'s own header comment already earmarks this field name for
/// Phase 7.6 to add).
///
/// **Teacher↔employee linkage (this phase's own resolved integration task, `implementation-plan.md`
/// Phase 7.6):** `teacherId` is the real link — an explicit, optional, unique FK to `Teacher.id`,
/// set at employee creation for staff who are also teachers. This is deliberately *not*
/// `Employee.id === Teacher.id` — the frontend's `TeacherProfile.tsx` (`TeacherLeaveTab`) currently
/// assumes that equality and passes `teacher.id` straight through as `employeeId`, which this
/// schema cannot make true in general (the two rows are independently created with independently
/// generated uuids). That call site needs a follow-up change to resolve the linked employee id
/// (e.g. via a `GET /hr/employees?teacherId=` lookup) instead — flagged here the same way other
/// phases have left a cross-stack decision for frontend follow-up rather than editing that repo
/// from here.
model Employee {
  id             String         @id @default(uuid())
  tenantId       String
  name           String
  email          String         @default("")
  phone          String         @default("")
  employeeId     String
  department     String
  designation    String
  employmentType EmploymentType
  dateOfJoining  DateTime       @db.Date
  status         EmployeeStatus @default(active)
  teacherId      String?        @unique
  userId         String?        @unique
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tenant          Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacher         Teacher?                 @relation(fields: [teacherId], references: [id])
  lifecycleEvents EmployeeLifecycleEvent[]
  leaveRequests   EmployeeLeaveRequest[]
  leaveBalances   LeaveBalance[]
  salaryStructure SalaryStructure?
  payslips        Payslip[]

  @@unique([tenantId, employeeId])
  @@index([tenantId])
  @@map("employees")
}

enum LifecycleEventType {
  transfer
  resignation
  termination
}

/// §21 lifecycle history — one append-only row per action (`EmployeeHistoryTab`'s timeline), never
/// edited or deleted; each write also flips the owning `Employee.status` in the same transaction
/// (`EmployeesService.recordLifecycleAction`'s own doc comment). `newDepartment`/`newDesignation`
/// only apply to `transfer`, same shared-shape/type-switched trade-off
/// `lifecycleActionSchema`'s `.refine()` pair already makes client-side.
model EmployeeLifecycleEvent {
  id             String             @id @default(uuid())
  tenantId       String
  employeeId     String
  type           LifecycleEventType
  effectiveDate  DateTime           @db.Date
  reason         String
  newDepartment  String?
  newDesignation String?
  recordedAt     DateTime           @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([employeeId])
  @@map("employee_lifecycle_events")
}

enum EmployeeLeaveType {
  casual
  sick
  annual
  unpaid
}

enum EmployeeLeaveStatus {
  pending
  approved
  rejected
}

/// §14 Employee Leave — mirrors student `LeaveRequest` above (own model, own table: the two
/// domains never share rows, only the shape) with an added `leaveType`, since staff balances split
/// by type where student leave doesn't. `reviewedByUserId`/`.Label` are the same denormalized
/// actor snapshot `LeaveRequest`/`DocumentVersion` already use.
model EmployeeLeaveRequest {
  id               String              @id @default(uuid())
  tenantId         String
  employeeId       String
  leaveType        EmployeeLeaveType
  startDate        DateTime            @db.Date
  endDate          DateTime            @db.Date
  reason           String
  status           EmployeeLeaveStatus @default(pending)
  reviewedByUserId String?
  reviewedByLabel  String?
  reviewNotes      String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([employeeId])
  @@index([status])
  @@map("employee_leave_requests")
}

/// §14 per-employee, per-type balance — `getLeaveBalances`'s `{ leaveType, allotted, used }[]`.
/// One row per `(employee, leaveType)`, seeded with a fixed default allotment for all four types
/// when the employee is created (`EmployeesService.create`'s own doc comment — same "fixed list,
/// not configurable" call the leave-type enum above already makes); `used` increments by the
/// requested leave's business-day span the moment a request is approved (`EmployeeLeaveService.
/// review`), never recomputed from history on read.
model LeaveBalance {
  id         String            @id @default(uuid())
  tenantId   String
  employeeId String
  leaveType  EmployeeLeaveType
  allotted   Int
  used       Int               @default(0)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, employeeId, leaveType])
  @@index([tenantId])
  @@index([employeeId])
  @@map("leave_balances")
}

/// §20 Salary structure config — the only payroll math the frontend itself ever owns is capturing
/// these fixed inputs (`SalaryStructureForm`); the payslip breakdown is computed entirely from
/// this row plus overtime/bonus/absence inputs at run time (`payroll-calc.ts`), never previewed
/// client-side (module doc "Simplifications made to fit this doc's own scope"). One row per
/// employee — `@unique` on `employeeId`, not its own `id`-keyed list, matching `GET/PUT
/// /payroll/salary-structures/:employeeId`'s single-resource contract exactly.
model SalaryStructure {
  id                 String   @id @default(uuid())
  tenantId           String
  employeeId         String   @unique
  basicSalary        Float
  housingAllowance   Float    @default(0)
  transportAllowance Float    @default(0)
  otherAllowance     Float    @default(0)
  taxDeduction       Float    @default(0)
  loanDeduction      Float    @default(0)
  otherDeduction     Float    @default(0)
  updatedAt          DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("salary_structures")
}

enum PayrollPeriodStatus {
  draft
  generated
  approved
}

/// §20 Payroll period — `draft → generated → approved`, mirroring `examinations.md`'s marks-entry
/// → results → publish gate (module doc "Payroll period management, run trigger, payslip
/// generation"). `run` (draft → generated) creates one `Payslip` per active `Employee` with a
/// `SalaryStructure`; `approve` (generated → approved) is the publish gate — payslips become
/// visible to each employee's own self-service view only once approved (`PayslipsService.list`'s
/// own doc comment), matching `results.publish`'s lock-after-publish semantics referenced above.
model PayrollPeriod {
  id        String              @id @default(uuid())
  tenantId  String
  label     String
  startDate DateTime            @db.Date
  endDate   DateTime            @db.Date
  status    PayrollPeriodStatus @default(draft)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payslips Payslip[]

  @@index([tenantId])
  @@map("payroll_periods")
}

/// §20 Payslip — one row per `(period, employee)` generated by `POST /payroll/periods/:id/run`,
/// never edited afterward (a correction re-runs the whole period, same all-or-nothing regeneration
/// `InvoicesService`'s own generation step uses — there is no single-payslip edit endpoint in this
/// contract). Every field below is the PRD §20 formula's own line item, computed server-side once
/// at generation time (`payroll-calc.ts`) and only ever displayed afterward — `netPay` is stored,
/// not recomputed on read, so a later `SalaryStructure` edit never silently changes a past payslip.
model Payslip {
  id               String   @id @default(uuid())
  tenantId         String
  periodId         String
  employeeId       String
  basicSalary      Float
  allowances       Float
  overtime         Float    @default(0)
  bonus            Float    @default(0)
  tax              Float
  deductions       Float
  absenceDeduction Float    @default(0)
  loanDeduction    Float
  netPay           Float
  generatedAt      DateTime @default(now())

  period   PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employee Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([periodId, employeeId])
  @@index([tenantId])
  @@index([periodId])
  @@index([employeeId])
  @@map("payslips")
}

// ---------------------------------------------------------------------------
// Communication (PRD §28 Communication, §29 Events & Calendar, §30 Parent-Teacher Meetings,
// Phase 7.7) — `frontend/modules/communication.md`'s five sub-areas: notifications, internal
// messaging, announcements, events/calendar, PTM. `userId`/`senderId`/`bookedByUserId` below are
// plain scoped columns with no Prisma relation to `User`, same "no back-relation from a feature
// model to `User`" convention every earlier phase's own self-service field already uses
// (`Employee.userId`, `Teacher.userId`, `Student.userId`, `Parent.userId`).
// ---------------------------------------------------------------------------

enum NotificationType {
  attendance
  homework
  exam
  fees
  announcement
  message
  ptm
  library
  system
  billing
}

enum NotificationChannel {
  inApp
  email
  sms
  whatsapp
}

/// §28/§36 in-app notification center — `NotificationBell`/`NotificationList`'s own feed.
/// `NotificationsService` writes these directly from this module's own messaging/PTM flows (module
/// doc "Backend dependencies": "this module is just the inbox UI ... never the delivery
/// infrastructure" — §36's actual push/email/SMS/WhatsApp fan-out across every *other* module's own
/// mutations is out of this phase's scope, left for a background-worker follow-up same as that
/// doc's own "Real-time delivery ... deferred" note). No `tenant Tenant @relation` here — same
/// high-volume-leaf-table trade-off `ExamMark`/`AttendanceRecord` already make, plain scoped
/// `tenantId` column only.
model Notification {
  id        String           @id @default(uuid())
  tenantId  String
  userId    String
  type      NotificationType
  title     String
  body      String
  linkHref  String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([tenantId])
  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

/// One row per `(user, type)` — a type with no row yet defaults to `[inApp]` at read time
/// (`NotificationsService.getPreferences`'s own doc comment), same "always return every value,
/// default the missing ones" idiom `LeaveBalance`'s per-type rows already use.
model NotificationPreference {
  id       String                @id @default(uuid())
  tenantId String
  userId   String
  type     NotificationType
  channels NotificationChannel[]

  @@unique([tenantId, userId, type])
  @@index([tenantId])
  @@index([userId])
  @@map("notification_preferences")
}

enum MessageRecipientType {
  individual
  class
}

/// §28 internal messaging — `recipientType`/`classId` are create-time audience info, stored for
/// reference but never echoed back on the wire (the frontend's own `MessageThread` type has no such
/// field — same "stored, not echoed" precedent `Exam.isPublished`'s own doc comment sets).
/// `participants` is the real per-user membership/read-state; a "class" thread fans out to one
/// `MessageParticipant` row per parent of that class at creation time (only parents with a linked
/// portal `User` — same documented gap as `Parent.userId`), not resolved dynamically on every read.
model MessageThread {
  id              String               @id @default(uuid())
  tenantId        String
  subject         String
  recipientType   MessageRecipientType
  classId         String?
  createdByUserId String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  participants MessageParticipant[]
  messages     Message[]

  @@index([tenantId])
  @@map("message_threads")
}

/// Membership + per-participant read-state — `MessageThread.unreadCount`'s own denominator
/// (`MessagesService.toThreadResponse`'s own doc comment). `label` is a denormalized display-name
/// snapshot taken when the participant is added (no `User` relation on this side, see this
/// section's header comment).
model MessageParticipant {
  id         String    @id @default(uuid())
  tenantId   String
  threadId   String
  userId     String
  label      String
  lastReadAt DateTime?

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("message_participants")
}

/// One row per message. `readAt` on the frontend's own `Message` type is always `null` here —
/// per-message read receipts are explicitly triaged out of this phase (module doc "Messaging");
/// only the thread-level `unreadCount` (derived from `MessageParticipant.lastReadAt`) is real.
model Message {
  id          String   @id @default(uuid())
  tenantId    String
  threadId    String
  senderId    String
  senderLabel String
  body        String
  createdAt   DateTime @default(now())

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([threadId])
  @@map("messages")
}

enum AnnouncementAudience {
  school
  class
}

/// §28 broadcast announcements — `classIds` is a plain scalar array for a "class" audience, same
/// `Homework.classIds` convention (module doc: "individual" audience isn't built — message someone
/// instead). No route-level read-scoping by the caller's own class: every recipient sees every
/// tenant-wide announcement, matching the built contract's `GET /announcements` taking no student/
/// class filter param.
model Announcement {
  id              String               @id @default(uuid())
  tenantId        String
  title           String
  body            String
  audience        AnnouncementAudience
  classIds        String[]
  pinned          Boolean              @default(false)
  createdByUserId String
  createdByLabel  String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("announcements")
}

/// `EVENT_TYPES`'s own hyphenated members (`sports-day`/`annual-function`/`field-trip`) aren't
/// valid Prisma enum identifiers — `sports_day`/`annual_function`/`field_trip` here, translated at
/// the response-DTO boundary (`EventsService`'s own doc comment), same kind of wire-vs-storage
/// translation `parseDateOnly`/`formatDateOnly` already do for dates.
enum EventType {
  holiday
  exam
  ptm
  sports_day
  annual_function
  field_trip
  meeting
  other
}

enum EventAudience {
  school
  class
}

/// §29 school calendar — only manually-created entries live in this table; the `holiday`/`exam`
/// rows `GET /events` also returns are synthesized at read time from `Holiday`/`Exam` (flagged
/// `isExternal`, module doc "Calendar view ... aggregating") and are never written here, so
/// `EventsService` never needs to special-case them on `PATCH`/`DELETE` — a synthetic id simply
/// doesn't match a real row here (`EventsService`'s own doc comment).
model Event {
  id          String        @id @default(uuid())
  tenantId    String
  title       String
  type        EventType
  date        DateTime      @db.Date
  startTime   String        @default("")
  endTime     String        @default("")
  location    String        @default("")
  description String        @default("")
  audience    EventAudience
  classIds    String[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([date])
  @@map("events")
}

/// §30 Parent-Teacher Meetings — a slot and its booking are the same row (module doc: "not two
/// entities"). `teacherId` is the real `Teacher.id` (`PtmBookingFlow`'s own `useTeachersQuery`
/// lookup sends that); `PtmSlotManager`'s own read-side `teacherId: session.user.id` is a known
/// frontend mismatch flagged in `../implementation-plan.md`'s Phase 7.7 section, not something this
/// schema works around. `bookedByUserId`/`bookedByLabel` are named `bookedByParentId`/
/// `bookedByParentLabel` on the wire (`PtmSlot`'s own frontend type) even though a Student session
/// can also book their own meeting (`PtmBookingFlow`'s own doc comment) — same "field name predates
/// a since-broadened assumption" precedent `Employee.teacherId`'s own doc comment already sets.
model PtmSlot {
  id             String   @id @default(uuid())
  tenantId       String
  teacherId      String
  date           DateTime @db.Date
  startTime      String
  endTime        String
  bookedByUserId String?
  bookedByLabel  String?
  studentId      String?
  studentLabel   String?
  notes          String   @default("")
  followUpAction String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([teacherId])
  @@index([bookedByUserId])
  @@map("ptm_slots")
}

// ---------------------------------------------------------------------------
// Audit (PRD §43)
// ---------------------------------------------------------------------------

/// Written by `AuditInterceptor` (generic) and, for anything needing a real before/after diff, by
/// feature services directly. No `onDelete: Cascade` relation to `User` for `actorUserId` on
/// purpose — an audit trail must survive the actor's own record being removed later, so it's a
/// plain string, not a enforced foreign key.
///
/// Append-only in practice, not just by convention: the deploy migration for this table should
/// grant the application's runtime DB role INSERT/SELECT only, never UPDATE/DELETE — track that
/// as an infra task alongside this model, not something Prisma's schema can express on its own.
model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  oldValue    Json?
  newValue    Json?
  ip          String?
  userAgent   String?
  requestId   String?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Platform Console (PRD §53/§54, Phase 7.9) — Super Admin only, genuinely cross-tenant.
// ---------------------------------------------------------------------------
//
// None of the five models below are in `common/prisma/tenant-scoped-models.ts`'s
// `TENANT_SCOPED_MODELS` — deliberately: `platform/` is the one module allowed to read across
// every tenant at once (PRD §54), through `PlatformPrismaService` (`platform-prisma.service.ts`'s
// own doc comment already reserved this as its second sanctioned call site), never the
// tenant-scoped `PrismaService`. Adding these to `TENANT_SCOPED_MODELS` would be actively wrong,
// not just unnecessary — every read here needs to see rows across tenants, not just one.

/// No fixed tiers — pricing is negotiated per school (`Subscription.monthlyAmount`), so this enum
/// only tracks a subscription's payment lifecycle: `ACTIVE` (paid through `currentPeriodEnd`),
/// `GRACE` (period lapsed, within the Platform-Admin-configured grace window —
/// `PlatformSettings.subscriptionGracePeriodDays`), `SUSPENDED` (grace window lapsed unpaid,
/// `subscription-sweep.service.ts` auto-suspends the tenant too), `CANCELED` (manual, Platform
/// Admin only). Uppercase members, lowercased at the API boundary
/// (`platform/platform.mappers.ts`'s `lowerEnum`) — the same enum-vs-frontend-lowercase-literal-
/// union gap `TenantStatus` already had since Phase 0.
enum SubscriptionStatus {
  ACTIVE
  GRACE
  SUSPENDED
  CANCELED
}

/// One active subscription per tenant (`@@unique` on `tenantId`) — PRD §53 and the frontend's own
/// `Subscription` type (one row per tenant in `SubscriptionTable`) don't model a tenant holding
/// two concurrent subscriptions. Pricing is a manually negotiated PKR amount per school, not a
/// fixed global plan — see `platform/subscriptions.service.ts`. `graceEndsAt`/`lastReminderEmailAt`
/// are set by `platform/subscription-sweep.service.ts`'s daily sweep once `currentPeriodEnd`
/// lapses, and cleared again by `SubscriptionsService.confirmPayment` on renewal.
model Subscription {
  id                  String             @id @default(uuid())
  tenantId            String             @unique
  /// PKR, matching `Invoice.totalAmount`/payroll's own bare-`Float` money convention elsewhere in
  /// this schema — negotiated individually per school, not looked up from a shared plan table.
  monthlyAmount       Float
  status              SubscriptionStatus @default(ACTIVE)
  currentPeriodStart  DateTime
  currentPeriodEnd    DateTime
  /// Set once `currentPeriodEnd` lapses unpaid (`status: GRACE`); the sweep auto-suspends once
  /// `now > graceEndsAt`. Cleared back to null on the next confirmed payment.
  graceEndsAt         DateTime?
  /// Dedupes the sweep's reminder email/notification — set the first time a period is found
  /// lapsed, cleared on renewal, so a school in `GRACE` isn't re-emailed every sweep run.
  lastReminderEmailAt DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  billingRecords BillingRecord[]

  @@map("subscriptions")
}

enum BillingRecordStatus {
  PENDING
  PAID
  FAILED
}

/// One row per billing period (§53) — exactly one `PENDING` row exists per subscription at a
/// time, representing the current/upcoming charge; `SubscriptionsService.confirmPayment` marks it
/// `PAID` (`confirmedAt`/`confirmedByUserId` — a Platform Admin manually confirming a payment
/// received outside the platform, e.g. bank transfer) and creates the next period's `PENDING` row.
/// `FAILED` is admin-settable (uncollectible/waived), not a payment-gateway webhook outcome.
model BillingRecord {
  id                String              @id @default(uuid())
  tenantId          String
  subscriptionId    String
  periodLabel       String
  amount            Float
  status            BillingRecordStatus @default(PENDING)
  issuedAt          DateTime
  paidAt            DateTime?
  confirmedByUserId String?
  /// Denormalized snapshot of the confirming Platform Admin's name at confirmation time — same
  /// "survives the referenced row's own lifecycle" reasoning `AuditLog.actorUserId`/
  /// `FeatureFlag.tenantName` already document, not a live join.
  confirmedByName   String?
  confirmedAt       DateTime?
  note              String?
  createdAt         DateTime            @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("billing_records")
}

/// Single-row platform-wide config table — `id` is always the literal `"singleton"`, read/written
/// via upsert on that fixed id (`platform/platform-settings.service.ts`). Holds settings that
/// apply uniformly across every tenant rather than per-school, same reasoning `School.currency`/
/// `timezone`'s own Pakistan-only defaults give for staying a system-wide constant "for now."
model PlatformSettings {
  id                           String   @id @default("singleton")
  subscriptionGracePeriodDays  Int      @default(5)
  updatedAt                    DateTime @updatedAt

  @@map("platform_settings")
}

enum FeatureFlagScope {
  PLATFORM
  TENANT
}

/// `frontend/src/features/platform/api.ts`'s flat `FeatureFlag` shape covers both a platform-wide
/// default (`scope: PLATFORM`, `tenantId: null`) and one specific tenant's override
/// (`scope: TENANT`) in the same list — intended (not yet built) semantics: a `TENANT` row should
/// win over the `PLATFORM` row with the same `key` for that one tenant. No feature-owning module
/// (e.g. `hostel/`'s own "not every tenant is a boarding school" gating question — see
/// `../implementation-plan.md`'s Phase 7.5 notes) actually *reads* this table yet to gate its own
/// behavior — this phase only builds the Super Admin console side (list/toggle); wiring a real
/// consumer, and the "`TENANT` wins over `PLATFORM`" resolution that implies, is that consumer's
/// own future work, not guessed at here. Self-service flag *creation* isn't built either
/// (`platform-console.md`'s own "Open questions" note) — the catalog of `key`s is fixed by
/// `prisma/seed.ts`; only `enabled` is mutable via `PATCH /platform/feature-flags/:id`.
model FeatureFlag {
  id          String           @id @default(uuid())
  key         String
  label       String
  description String
  scope       FeatureFlagScope
  /// Set only when `scope = TENANT`. Plain fields, no relation — same "denormalized, survives the
  /// referenced row's own lifecycle" reasoning `AuditLog.actorUserId` already documents: an
  /// override should never silently cascade-vanish if the tenant were ever hard-deleted, and the
  /// resolver reads `tenantName` directly rather than joining `Tenant`/`School` on every request.
  tenantId    String?
  tenantName  String?
  enabled     Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  /// Real uniqueness for a `TENANT`-scoped row (`tenantId` non-null there); for a `PLATFORM` row
  /// (`tenantId: null`) this index does *not* actually stop a second row for the same `key` —
  /// Postgres treats every `NULL` in a unique index as distinct from every other, so two rows with
  /// `key: 'x', tenantId: null` don't collide at the DB level. `prisma/seed.ts` is what keeps the
  /// global catalog to one row per key in practice (`findFirst` + create-or-update, not `upsert`
  /// on this compound key — Prisma's own generated type for that shorthand refuses a `null`
  /// half). Worth a real partial unique index (`WHERE "tenantId" IS NULL`) if a second writer of
  /// `PLATFORM` rows ever shows up.
  @@unique([key, tenantId])
  @@map("feature_flags")
}

/// PRD §54's platform-level audit trail — distinct from the tenant-scoped `AuditLog` above
/// (`modules/platform-console.md`'s own "Backend dependencies": "distinct from a school's own
/// §43 audit logs"). Every field is a plain denormalized snapshot at write time, not a live join —
/// same `AuditLog.actorUserId` reasoning: a school being renamed, or a super admin account being
/// removed, later shouldn't rewrite what this row says happened at the time.
model PlatformAuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  actorLabel  String
  action      String
  target      String
  tenantId    String?
  tenantName  String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@map("platform_audit_logs")
}
